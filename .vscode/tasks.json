{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [ "build", "${workspaceFolder}/LibraryManagementSystem.csproj" ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [ "watch", "run", "--project", "${workspaceFolder}/LibraryManagementSystem.csproj" ],
      "problemMatcher": "$msCompile",
      "isBackground": true
    }
  ]
}
