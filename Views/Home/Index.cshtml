@{
    ViewData["Title"] = "Warm Archive & Wooden Shelf Library";
}

<!-- Grand Wooden Library Entrance Hero -->
<section class="sw-editorial-hero sw-fade-in-up my-4" aria-labelledby="home-hero-title">
    <div class="sw-hero-content">
        <div class="sw-hero-meta">
            <span class="brass-tag"><i class="bi bi-bank me-1"></i> GRAND ARCHIVE</span>
            <span class="sw-mono small">EST. UNIVERSITY ARCHIVE</span>
            <span class="d-none d-sm-inline">·</span>
            <span class="sw-mono small">READ. HIGHLIGHT. THINK. CREATE. SHARE.</span>
        </div>
        <h1 class="sw-hero-title" id="home-hero-title">
            The timeless warmth of wooden stacks,<br class="d-none d-sm-inline" />
            powered by <em>modern scholarship.</em>
        </h1>
        <p class="sw-hero-desc">
            A university-grade digital archive inspired by antique wooden reading rooms, library card catalogs, and parchment manuscripts. Browse realistic book spines, stream digital PDFs with side-by-side notes, and trade peer-reviewed research folios.
        </p>
        <div class="sw-hero-actions">
            <a class="sw-btn sw-btn-brass sw-btn-lg" asp-controller="Books" asp-action="Index">
                <i class="bi bi-bookshelf"></i> Explore Wooden Bookshelf
            </a>
            <a class="sw-btn sw-btn-forest sw-btn-lg" asp-controller="DigitalLibrary" asp-action="Index">
                <i class="bi bi-file-earmark-pdf"></i> Digital Reading Room
            </a>
            <a class="sw-btn sw-btn-outline sw-btn-lg" asp-controller="Marketplace" asp-action="Index">
                <i class="bi bi-mortarboard"></i> Research Marketplace
            </a>
        </div>
    </div>
    <div class="sw-hero-artwork" aria-hidden="true">
        <div class="sw-hero-art-circle"></div>
        <i class="bi bi-book-half sw-hero-art-icon"></i>
    </div>
</section>

<!-- Archival Pillars Grid -->
<section class="my-5 sw-fade-in-up" aria-labelledby="features-heading">
    <div class="sw-section-header">
        <div>
            <span class="sw-kicker sw-kicker-forest"><i class="bi bi-compass"></i> PLATFORM ARCHITECTURE</span>
            <h2 class="sw-h2" id="features-heading">Crafted for Scholars, Curators &amp; Researchers</h2>
        </div>
        <span class="brass-tag">ASP.NET Core &amp; EF Core 10</span>
    </div>

    <div class="sw-grid-4-col">
        <article class="parchment-card sw-stagger-1">
            <div class="sw-kpi-header">
                <span class="sw-kpi-label">Physical Archive</span>
                <div class="sw-kpi-icon sw-icon-brass"><i class="bi bi-bookshelf"></i></div>
            </div>
            <h3 class="sw-h3 mt-2 mb-2">Wooden Bookshelf</h3>
            <p class="text-muted small mb-4">
                Rich 3D horizontal book spines arranged on realistic wooden shelves with vertical embossed titles, leather colors, and lift-up hover transitions.
            </p>
            <div class="mt-auto pt-2 border-top border-warning border-opacity-25">
                <a class="sw-mono small text-decoration-none fw-bold" style="color: var(--sw-gold-brass);" asp-controller="Books" asp-action="Index">
                    Open bookshelf &rarr;
                </a>
            </div>
        </article>

        <article class="parchment-card sw-stagger-2">
            <div class="sw-kpi-header">
                <span class="sw-kpi-label">Digital Workspace</span>
                <div class="sw-kpi-icon sw-icon-forest"><i class="bi bi-layout-split"></i></div>
            </div>
            <h3 class="sw-h3 mt-2 mb-2">Parchment Reader</h3>
            <p class="text-muted small mb-4">
                Side-by-side workspace combining Mozilla PDF.js streaming, 4-color persistent highlights, autosaved Quill notes, and citation clipping.
            </p>
            <div class="mt-auto pt-2 border-top border-warning border-opacity-25">
                <a class="sw-mono small text-decoration-none fw-bold" style="color: var(--sw-forest-green);" asp-controller="DigitalLibrary" asp-action="Index">
                    Enter reading room &rarr;
                </a>
            </div>
        </article>

        <article class="parchment-card sw-stagger-3">
            <div class="sw-kpi-header">
                <span class="sw-kpi-label">Marketplace</span>
                <div class="sw-kpi-icon sw-icon-walnut"><i class="bi bi-mortarboard"></i></div>
            </div>
            <h3 class="sw-h3 mt-2 mb-2">Research Folios</h3>
            <p class="text-muted small mb-4">
                Scholarly manuscript marketplace with author publishing desk, editorial review, immutable document versioning, and itemized sales ledgers.
            </p>
            <div class="mt-auto pt-2 border-top border-warning border-opacity-25">
                <a class="sw-mono small text-decoration-none fw-bold" style="color: var(--sw-walnut-deep);" asp-controller="Marketplace" asp-action="Index">
                    Explore research &rarr;
                </a>
            </div>
        </article>

        <article class="parchment-card sw-stagger-4">
            <div class="sw-kpi-header">
                <span class="sw-kpi-label">Circulation Desk</span>
                <div class="sw-kpi-icon sw-icon-brass"><i class="bi bi-card-checklist"></i></div>
            </div>
            <h3 class="sw-h3 mt-2 mb-2">Rubber-Stamp Desk</h3>
            <p class="text-muted small mb-4">
                Vintage borrower card visuals, 14-day loan stamps, automated daily penalty calculations, and animated "STAMPED RETURNED" seals.
            </p>
            <div class="mt-auto pt-2 border-top border-warning border-opacity-25">
                <span class="sw-mono small text-muted">14-Day Terms · Zero-Grace Audit</span>
            </div>
        </article>
    </div>
</section>

<!-- Archival Quote Plaque -->
<section class="p-4 p-md-5 my-5 rounded text-center position-relative overflow-hidden" 
         style="background: radial-gradient(circle at 50% 50%, #3d291b 0%, #251810 100%); border: 2px solid var(--sw-gold-brass); box-shadow: 0 8px 24px rgba(20, 13, 8, 0.45);">
    <span class="brass-tag mb-3 d-inline-block">ARCHIVAL PROVERB</span>
    <blockquote class="blockquote my-2" style="font-family: var(--sw-font-heading); font-size: clamp(1.2rem, 2.5vw, 1.75rem); color: #fff8e9; font-style: italic;">
        &ldquo;A library is not a luxury but one of the necessities of life &mdash; an archive where the thoughts of centuries wait upon the scholar's touch.&rdquo;
    </blockquote>
    <figcaption class="blockquote-footer mt-2" style="color: var(--sw-gold-muted); font-family: var(--sw-font-mono);">
        Henry Ward Beecher &middot; Shelfwise University Archive Collection
    </figcaption>
</section>

<!-- Call to Action Band -->
<section class="sw-cta-card text-center my-5 sw-fade-in-up">
    <span class="brass-tag mb-2">OPEN ARCHIVE REGISTRATION</span>
    <h2 class="sw-h1 text-white mb-3">Begin Your Scholarship Journey</h2>
    <p class="mx-auto mb-4" style="max-width: 540px; color: var(--sw-gold-muted); font-size: var(--sw-text-md);">
        Enroll your digital library card today to browse wooden stacks, borrow volumes, take notes in the digital reading room, and publish research.
    </p>
    <div class="sw-cta-actions">
        <a class="sw-btn sw-btn-brass sw-btn-lg" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus"></i> Register Archive Card
        </a>
        <a class="sw-btn sw-btn-outline sw-btn-lg" asp-controller="Books" asp-action="Index">
            <i class="bi bi-bookshelf"></i> Browse Wooden Stacks
        </a>
    </div>
</section>
