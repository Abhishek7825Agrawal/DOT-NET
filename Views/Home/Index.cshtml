@{ ViewData["Title"] = "Welcome"; }
<div class="row align-items-center g-4 hero">
    <div class="col-lg-7">
        <div class="eyebrow">A calmer way to run your library</div>
        <h1>Every book, every borrower, in one place.</h1>
        <p class="mt-3">Browse the catalogue, keep track of loans, and see what is due next with Shelfwise Library.</p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary btn-lg" asp-controller="Books" asp-action="Index">
                <i class="bi bi-search me-1"></i> Browse Catalogue
            </a>
            <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Register">Join the library</a>
            <a class="btn btn-link btn-lg text-decoration-none" asp-controller="Account" asp-action="Login">Sign in</a>
        </div>
    </div>
    <div class="col-lg-5"><div class="hero-art"><i class="bi bi-book-half"></i></div></div>
</div>
