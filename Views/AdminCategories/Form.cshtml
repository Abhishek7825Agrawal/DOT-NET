@model CategoryFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Category" : "Edit Category";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker"><span class="sw-kicker-dot"></span> Catalogue Taxonomy</div>
        <h1 class="sw-title-display">@ViewData["Title"]</h1>
        <p class="sw-page-subtitle">Define or update collection classification labels and shelf scope notes.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i> Return to Categories
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="sw-table-card p-4 p-md-5 sw-fade-in-up">
            <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="sw-alert sw-alert-danger mb-4"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="sw-form-label">Category Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control sw-input" placeholder="e.g. Computer Science, Philosophy, Modern Literature" required />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="sw-form-label">Description / Scope Notes</label>
                    <textarea asp-for="Description" class="form-control sw-input" rows="3" style="height: auto;" placeholder="Subject scope, topics included, or physical shelf placement..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex align-items-center gap-3 pt-3 border-top" style="border-color: var(--sw-border) !important;">
                    <button class="sw-btn sw-btn-primary sw-btn-lg" type="submit">
                        <i class="bi bi-check-lg me-1"></i> Save Category
                    </button>
                    <a class="sw-btn sw-btn-outline sw-btn-lg" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
