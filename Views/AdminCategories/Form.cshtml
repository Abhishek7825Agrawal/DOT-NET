@model CategoryFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add Category" : "Edit Category"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Catalogue Taxonomy</div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-secondary mb-0 mt-1">Define or update collection classification labels.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i> Back to Categories
    </a>
</div>

<div class="panel" style="max-width:640px">
    <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Category Name <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Computer Science, Philosophy, Biology" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label">Description / Scope Notes</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Scope, topics covered, or shelf placement notes..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check-lg me-1"></i> Save Category
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

