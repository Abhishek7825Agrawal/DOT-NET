@model IReadOnlyList<CategoryBookCountDto>
@{ ViewData["Title"] = "Category Management"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Catalogue Taxonomy</div>
        <h1>Categories</h1>
        <p class="text-secondary mb-0 mt-1">Organize books into genres, subjects, and departmental classifications.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> Add Category
    </a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-tags"></i>
            <h3 class="h6 mt-3">No categories defined</h3>
            <p class="mb-0 text-muted">Create your first category to organize the library's collection.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Total Titles</th>
                        <th>Active Titles</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <span class="badge rounded-pill badge-soft me-1"><i class="bi bi-tag me-1"></i>@cat.Name</span>
                            </td>
                            <td>@(cat.Description ?? "—")</td>
                            <td><span class="fw-bold">@cat.TotalBooks</span> titles</td>
                            <td><span class="badge rounded-pill text-bg-light">@cat.ActiveBooks active</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@cat.Id">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline" data-confirm="Delete category '@cat.Name'? (Only categories with no assigned titles can be removed.)">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" @(cat.TotalBooks > 0 ? "disabled" : "") title="@(cat.TotalBooks > 0 ? "Cannot delete category while books are assigned to it." : "Delete category")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

