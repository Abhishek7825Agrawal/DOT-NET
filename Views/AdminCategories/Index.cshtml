@model IReadOnlyList<CategoryBookCountDto>
@{
    ViewData["Title"] = "Category Taxonomy";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker"><span class="sw-kicker-dot"></span> Catalogue Taxonomy</div>
        <h1 class="sw-title-display">Categories</h1>
        <p class="sw-page-subtitle">Organize books into thematic disciplines, genres, and academic classifications.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </a>
    </div>
</div>

<div class="sw-table-card">
    @if (Model.Count == 0)
    {
        <div class="sw-empty-state py-5">
            <div class="sw-empty-icon"><i class="bi bi-tags"></i></div>
            <h3 class="sw-empty-title">No categories defined</h3>
            <p class="sw-empty-text">Create your first subject category to organize the library's collection.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="sw-table mb-0">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description / Scope</th>
                        <th>Total Titles</th>
                        <th>Active Titles</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <span class="sw-badge sw-badge-neutral me-1"><i class="bi bi-tag me-1 text-primary"></i>@cat.Name</span>
                            </td>
                            <td class="text-muted">@(cat.Description ?? "—")</td>
                            <td><span class="fw-bold font-monospace">@cat.TotalBooks</span> titles</td>
                            <td><span class="sw-badge sw-badge-neutral font-monospace">@cat.ActiveBooks active</span></td>
                            <td class="text-end text-nowrap">
                                <a class="sw-btn sw-btn-sm sw-btn-outline me-1" asp-action="Edit" asp-route-id="@cat.Id">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline" data-confirm="Delete category '@cat.Name'? (Only categories with zero assigned titles can be removed.)">
                                    <button class="sw-btn sw-btn-sm sw-btn-outline text-danger" type="submit" @(cat.TotalBooks > 0 ? "disabled" : "") title="@(cat.TotalBooks > 0 ? "Cannot delete category while books are assigned to it." : "Delete category")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
