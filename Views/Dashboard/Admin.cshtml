@model AdminDashboardData
@{
    ViewData["Title"] = "Editorial Overview";
    var maxWeekly = Math.Max(1, Model.WeeklyIssueActivity.Count > 0 ? Model.WeeklyIssueActivity.Max(d => d.IssueCount) : 1);
}

<!-- Section 2: Large Editorial Welcome Heading -->
<section class="sw-editorial-hero sw-fade-in-up" aria-labelledby="hero-title">
    <div class="sw-hero-content">
        <div class="sw-hero-meta">
            <span class="sw-kicker">Dispatches from the Stacks</span>
            <span class="sw-volume-tag">Vol. XII · No. 19</span>
            <span>·</span>
            <span><i class="bi bi-calendar3 me-1"></i>@DateTime.Today.ToString("dddd, d MMMM yyyy")</span>
        </div>
        <h1 class="sw-hero-title" id="hero-title">
            Curating knowledge,<br />
            <em>one volume at a time.</em>
        </h1>
        <p class="sw-hero-desc">
            Welcome to the Shelfwise administrative desk. Here is your daily operational briefing across collection health, borrower circulation, and reader engagement.
        </p>
        <div class="sw-hero-actions">
            <a class="sw-btn sw-btn-accent" asp-controller="AdminCirculation" asp-action="Issue">
                <i class="bi bi-plus-circle"></i> Issue a Book
            </a>
            <a class="sw-btn sw-btn-outline" asp-controller="AdminMembers" asp-action="RegisterCustomer">
                <i class="bi bi-person-plus"></i> Enroll Member
            </a>
            <a class="sw-btn sw-btn-outline" asp-controller="AdminReports" asp-action="Index">
                <i class="bi bi-bar-chart-line"></i> Circulation Reports
            </a>
            <a class="sw-btn sw-btn-outline" asp-controller="AdminBooks" asp-action="Create">
                <i class="bi bi-journal-plus"></i> Add Title
            </a>
        </div>
    </div>
    <div class="sw-hero-artwork" aria-hidden="true">
        <div class="sw-hero-art-circle"></div>
        <i class="bi bi-book-half sw-hero-art-icon"></i>
    </div>
</section>

<!-- Section 3: Library Overview Statistics (Asymmetric Balanced KPI Suite) -->
<section class="sw-grid-kpi" aria-label="Library Overview Metrics">
    <!-- Primary Key Metric -->
    <article class="sw-kpi-card sw-kpi-primary sw-stagger-1">
        <div class="sw-kpi-header">
            <span class="sw-kpi-label">Catalogued Titles</span>
            <div class="sw-kpi-icon sw-icon-terracotta"><i class="bi bi-journals"></i></div>
        </div>
        <div class="sw-kpi-value" data-count-up="@Model.TotalBooks">@Model.TotalBooks.ToString("N0")</div>
        <div class="sw-kpi-footer">
            <i class="bi bi-check2-circle text-success"></i>
            <span>@Model.AvailableCopies.ToString("N0") shelf copies ready</span>
        </div>
    </article>

    <!-- Active Cardholder Members -->
    <article class="sw-kpi-card sw-stagger-2">
        <div class="sw-kpi-header">
            <span class="sw-kpi-label">Active Readers</span>
            <div class="sw-kpi-icon sw-icon-sage"><i class="bi bi-people"></i></div>
        </div>
        <div class="sw-kpi-value" data-count-up="@Model.TotalMembers">@Model.TotalMembers.ToString("N0")</div>
        <div class="sw-kpi-footer">
            <a class="text-decoration-none text-muted" asp-controller="AdminMembers" asp-action="Index">
                Member directory <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </article>

    <!-- Current Circulation Out -->
    <article class="sw-kpi-card sw-stagger-3">
        <div class="sw-kpi-header">
            <span class="sw-kpi-label">Books on Loan</span>
            <div class="sw-kpi-icon sw-icon-navy"><i class="bi bi-arrow-left-right"></i></div>
        </div>
        <div class="sw-kpi-value" data-count-up="@Model.ActiveLoans">@Model.ActiveLoans.ToString("N0")</div>
        <div class="sw-kpi-footer">
            <a class="text-decoration-none text-muted" asp-controller="AdminCirculation" asp-action="Index">
                Circulation desk <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </article>

    <!-- Overdue Loans Alert KPI -->
    <article class="sw-kpi-card @(Model.OverdueLoans > 0 ? "border-danger" : "") sw-stagger-4">
        <div class="sw-kpi-header">
            <span class="sw-kpi-label">Overdue Returns</span>
            <div class="sw-kpi-icon sw-icon-danger"><i class="bi bi-clock-history"></i></div>
        </div>
        <div class="sw-kpi-value @(Model.OverdueLoans > 0 ? "text-danger" : "")" data-count-up="@Model.OverdueLoans">@Model.OverdueLoans.ToString("00")</div>
        <div class="sw-kpi-footer">
            @if (Model.OverdueLoans > 0)
            {
                <a class="text-danger fw-semibold text-decoration-none" asp-controller="AdminCirculation" asp-action="Overdue">
                    Immediate recall needed <i class="bi bi-arrow-right"></i>
                </a>
            }
            else
            {
                <span class="text-success"><i class="bi bi-check-circle me-1"></i>All loans on schedule</span>
            }
        </div>
    </article>
</section>

<!-- Section 4 & 6: Circulation Analytics and Recent Borrowing Activity -->
<div class="sw-grid-asymmetric">
    <!-- Left: Recent Borrowing Desk Activity -->
    <section class="sw-table-card sw-fade-in-up" aria-labelledby="activity-heading">
        <div class="p-4 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <span class="sw-kicker">Desk Circulation</span>
                <h3 class="sw-h3 mb-0" id="activity-heading">Recent Issues &amp; Returns</h3>
            </div>
            <a class="sw-btn sw-btn-outline sw-btn-sm" asp-controller="AdminCirculation" asp-action="Index">
                Full Log <i class="bi bi-arrow-up-right ms-1"></i>
            </a>
        </div>

        @if (Model.RecentIssues.Count == 0)
        {
            <div class="sw-empty-state">
                <div class="sw-empty-icon"><i class="bi bi-journal-bookmark"></i></div>
                <h4 class="sw-empty-title">Quiet shelves today</h4>
                <p class="sw-empty-text">No book loans recorded yet. New circulation actions will appear in this ledger immediately.</p>
                <a class="sw-btn sw-btn-primary sw-btn-sm" asp-controller="AdminCirculation" asp-action="Issue">Issue the first book</a>
            </div>
        }
        else
        {
            <div class="sw-table-responsive">
                <table class="sw-table">
                    <thead>
                        <tr>
                            <th>Book &amp; Reader</th>
                            <th>Issued Date</th>
                            <th>Due Back</th>
                            <th>Loan Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentIssues)
                        {
                            var isLate = item.Status == IssueStatus.Active && item.DueDateUtc.Date < DateTime.UtcNow.Date;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="sw-kpi-icon sw-icon-sage" style="width:34px;height:34px;font-size:.9rem">
                                            <i class="bi bi-book"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-truncate" style="max-width:240px">@item.Book.Title</div>
                                            <div class="sw-mono text-muted small">@item.Member.FullName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="sw-mono">@item.IssueDateUtc.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="sw-mono @(isLate ? "text-danger fw-bold" : "")">
                                        @item.DueDateUtc.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == IssueStatus.Active)
                                    {
                                        if (isLate)
                                        {
                                            <span class="sw-badge sw-badge-danger"><span class="sw-badge-dot"></span>Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="sw-badge sw-badge-success"><span class="sw-badge-dot"></span>On Loan</span>
                                        }
                                    }
                                    else if (item.Status == IssueStatus.Returned)
                                    {
                                        <span class="sw-badge sw-badge-neutral"><span class="sw-badge-dot"></span>Returned</span>
                                    }
                                    else
                                    {
                                        <span class="sw-badge sw-badge-warning"><span class="sw-badge-dot"></span>Lost</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Right: 7-Day Issue Rhythm Chart & Availability Panel -->
    <aside class="d-flex flex-column gap-4">
        <!-- 7-Day Circulation Rhythm Chart -->
        <section class="sw-analytics-panel sw-fade-in-up" aria-labelledby="rhythm-heading">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="sw-kicker">Weekly Cadence</span>
                    <h4 class="sw-h4 mb-0" id="rhythm-heading">Issue Rhythm</h4>
                </div>
                <span class="sw-badge sw-badge-info">7-Day Trajectory</span>
            </div>

            @if (Model.WeeklyIssueActivity.Count == 0 || Model.WeeklyIssueActivity.Sum(d => d.IssueCount) == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bar-chart fs-2 text-subtle mb-2"></i>
                    <p class="small mb-0">No circulation recorded this week.</p>
                </div>
            }
            else
            {
                <div class="sw-chart-bars" role="img" aria-label="Daily book issues over the past 7 days">
                    @foreach (var day in Model.WeeklyIssueActivity)
                    {
                        var barPercent = Math.Max(10, (int)Math.Round(day.IssueCount * 100.0 / maxWeekly));
                        <div class="sw-chart-col" title="@day.Date.ToString("dddd, d MMM"): @day.IssueCount issues">
                            <span class="sw-mono" style="font-size:0.68rem">@day.IssueCount</span>
                            <div class="sw-chart-bar-wrap">
                                <div class="sw-chart-bar-fill accent" data-height="@barPercent%" style="height:@barPercent%"></div>
                            </div>
                            <span class="sw-chart-day-label">@day.Date.ToString("ddd").Substring(0, 2)</span>
                        </div>
                    }
                </div>
                <div class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top small text-muted">
                    <span><strong>@Model.WeeklyIssueActivity.Sum(d => d.IssueCount)</strong> books issued in last 7 days</span>
                    <span class="sw-mono text-terracotta"><i class="bi bi-circle-fill" style="font-size:.5rem"></i> Active</span>
                </div>
            }
        </section>

        <!-- Overdue Check-in & Outstanding Ledger Card -->
        <section class="sw-kpi-card @(Model.OverdueLoans > 0 ? "border-danger" : "")">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="sw-kicker mb-0">Fine Ledger</span>
                <span class="sw-badge sw-badge-warning">Financial Summary</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 my-2">
                <span class="sw-stat-number text-terracotta fs-2">@Model.OutstandingFines.ToString("C")</span>
                <span class="small text-muted">uncollected balance</span>
            </div>
            <p class="small text-muted mb-3">
                @(Model.OverdueLoans > 0 
                    ? $"{Model.OverdueLoans} {(Model.OverdueLoans == 1 ? "book is" : "books are")} past due and generating daily overdue assessments."
                    : "No overdue liabilities detected. All book loans are on schedule.")
            </p>
            <div class="d-flex gap-2">
                <a class="sw-btn sw-btn-outline sw-btn-sm flex-grow-1" asp-controller="AdminCirculation" asp-action="Overdue">
                    <i class="bi bi-clock-history"></i> Overdue List
                </a>
                <a class="sw-btn sw-btn-primary sw-btn-sm" asp-controller="AdminCirculation" asp-action="Payments">
                    <i class="bi bi-cash-stack"></i> Fines Desk
                </a>
            </div>
        </section>
    </aside>
</div>

<!-- Section 5: Reader Favourites / Popular Shelf Showcase -->
<section class="mt-5 sw-fade-in-up" aria-labelledby="favourites-heading">
    <div class="sw-section-header">
        <div>
            <span class="sw-kicker">Curator's Spotlight</span>
            <h2 class="sw-h2" id="favourites-heading">Popular on the Shelves</h2>
        </div>
        <a class="sw-section-action" asp-controller="AdminBooks" asp-action="Index">
            Explore Full Inventory <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (Model.PopularBooks.Count == 0)
    {
        <div class="sw-empty-state">
            <div class="sw-empty-icon"><i class="bi bi-stars"></i></div>
            <h4 class="sw-empty-title">Stories are waiting</h4>
            <p class="sw-empty-text">Once readers borrow books, the most sought-after volumes will be curated here.</p>
        </div>
    }
    else
    {
        <div class="sw-showcase-grid">
            @for (var i = 0; i < Model.PopularBooks.Count; i++)
            {
                var book = Model.PopularBooks[i];
                <article class="sw-book-card">
                    <div class="sw-book-cover-container">
                        <div class="sw-book-cover-placeholder">
                            <span class="sw-placeholder-spine">Shelfwise Pick</span>
                            <div class="sw-placeholder-title">@book.Title</div>
                            <div class="sw-placeholder-author">@book.Author</div>
                        </div>
                    </div>
                    <div class="sw-book-card-body">
                        <div class="sw-book-meta-top">
                            <span class="sw-badge sw-badge-neutral">@book.Category</span>
                            <span class="sw-mono small text-terracotta"><i class="bi bi-arrow-repeat"></i> @book.IssueCount</span>
                        </div>
                        <h4 class="sw-book-title" title="@book.Title">@book.Title</h4>
                        <div class="sw-book-author">@book.Author</div>
                    </div>
                </article>
            }
        </div>
    }
</section>
