@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }

<div class="auth-wrap">
    <div class="auth-card">
        <div class="eyebrow">Account Security</div>
        <h1 class="h3 mb-2">Change Password</h1>
        <p class="text-secondary mb-4">Choose a strong, unique password to protect your library account.</p>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" required />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" required />
                <div class="form-text">Must be at least 10 characters and contain upper, lower, numbers, and symbols.</div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button class="btn btn-primary w-100 mb-2" type="submit">
                <i class="bi bi-shield-check me-1"></i> Update Password
            </button>
            <a class="btn btn-outline-secondary w-100" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

