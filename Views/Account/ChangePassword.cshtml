@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Security & Password";
}

<div class="row justify-content-center my-4 sw-fade-in-up">
    <div class="col-md-7 col-lg-5">
        <div class="sw-table-card p-4 p-md-5">
            <span class="sw-kicker">Account Security</span>
            <h1 class="sw-h2 mb-2">Change Password</h1>
            <p class="text-muted small mb-4">Choose a strong, unique passphrase to safeguard your cardholder account.</p>

            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="sw-alert sw-alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="sw-form-label">Current Password</label>
                    <input asp-for="CurrentPassword" class="sw-form-control" autocomplete="current-password" required />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="sw-form-label">New Password</label>
                    <input asp-for="NewPassword" class="sw-form-control" autocomplete="new-password" required />
                    <div class="sw-mono text-muted" style="font-size:0.7rem;margin-top:0.3rem">
                        Minimum 10 characters: upper, lower, numbers, and symbols.
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="sw-form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="sw-form-control" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-column gap-2">
                    <button class="sw-btn sw-btn-primary w-100" type="submit">
                        <i class="bi bi-shield-check"></i> Update Password
                    </button>
                    <a class="sw-btn sw-btn-outline w-100" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
