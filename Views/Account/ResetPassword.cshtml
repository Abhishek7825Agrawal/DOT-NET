@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<section class="auth-shell sw-fade-in-up" aria-labelledby="reset-title">
    <div class="auth-card auth-card-wide">
        <span class="sw-kicker">Secure account recovery</span>
        <h1 id="reset-title" class="sw-h2">Choose a new password</h1>
        <form asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="sw-alert sw-alert-danger" role="alert"></div>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="mb-3">
                <label asp-for="NewPassword" class="sw-form-label"></label>
                <input asp-for="NewPassword" class="sw-form-control" autocomplete="new-password" aria-describedby="password-strength password-rules" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div id="password-strength" class="password-strength mt-2" aria-live="polite">Password strength: enter a password</div>
                <small id="password-rules" class="form-text">Use at least 10 characters with uppercase, lowercase, a number, and a symbol.</small>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="sw-form-label"></label>
                <input asp-for="ConfirmPassword" class="sw-form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button class="sw-btn sw-btn-primary w-100" type="submit">Update password</button>
        </form>
    </div>
</section>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
    const resetToken = new URLSearchParams(window.location.hash.slice(1)).get('token');
    const tokenInput = document.getElementById('Token');
    if (resetToken && tokenInput) {
        tokenInput.value = resetToken;
        window.history.replaceState(null, document.title, window.location.pathname + window.location.search);
    }
    const input = document.getElementById('NewPassword');
    const output = document.getElementById('password-strength');
    if (!input || !output) return;
    input.addEventListener('input', () => {
        const value = input.value;
        const checks = [value.length >= 10, /[a-z]/.test(value), /[A-Z]/.test(value), /\d/.test(value), /[^A-Za-z0-9]/.test(value)];
        const score = checks.filter(Boolean).length;
        const label = score < 2 ? 'Weak' : score < 4 ? 'Fair' : score === 4 ? 'Good' : 'Strong';
        output.textContent = value ? `Password strength: ${label} (${score}/5)` : 'Password strength: enter a password';
        output.dataset.strength = label.toLowerCase();
    });
})();
</script>
}
