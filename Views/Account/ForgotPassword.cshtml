@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<section class="auth-shell sw-fade-in-up" aria-labelledby="forgot-title">
    <div class="auth-card auth-card-wide">
        <span class="sw-kicker">Account recovery</span>
        <h1 id="forgot-title" class="sw-h2">Forgot your password?</h1>
        <p class="auth-intro">Enter the email address on your library account. If an eligible account exists, we’ll send a secure reset link.</p>
        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="sw-alert sw-alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="sw-form-label"></label>
                <input asp-for="Email" class="sw-form-control" autocomplete="email" inputmode="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button class="sw-btn sw-btn-primary w-100" type="submit">Send reset link</button>
        </form>
        <p class="auth-switch"><a asp-action="Login">Back to sign in</a></p>
    </div>
</section>
