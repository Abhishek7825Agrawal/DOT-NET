@{
    ViewData["Title"] = "Password updated";
}
<section class="auth-shell sw-fade-in-up" aria-labelledby="reset-success-title">
    <div class="auth-card auth-card-wide">
        <span class="sw-kicker">Account recovery complete</span>
        <h1 id="reset-success-title" class="sw-h2">Password updated</h1>
        <p class="auth-intro">Your password has been changed. Sign in with your new password.</p>
        <a class="sw-btn sw-btn-primary" asp-action="Login">Sign in</a>
    </div>
</section>
