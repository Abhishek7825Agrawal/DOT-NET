@{
    ViewData["Title"] = "Check your email";
}
<section class="auth-shell sw-fade-in-up" aria-labelledby="forgot-confirm-title">
    <div class="auth-card auth-card-wide">
        <span class="sw-kicker">Account recovery</span>
        <h1 id="forgot-confirm-title" class="sw-h2">Check your email</h1>
        <p class="auth-intro">If an eligible account matches that address, reset instructions will be sent when email delivery is configured. If nothing arrives, contact your library administrator.</p>
        <a class="sw-btn sw-btn-primary" asp-action="Login">Return to sign in</a>
    </div>
</section>
