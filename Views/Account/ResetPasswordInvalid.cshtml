@{
    ViewData["Title"] = "Reset link unavailable";
}
<section class="auth-shell sw-fade-in-up" aria-labelledby="reset-invalid-title">
    <div class="auth-card auth-card-wide">
        <span class="sw-kicker">Account recovery</span>
        <h1 id="reset-invalid-title" class="sw-h2">This reset link is unavailable</h1>
        <p class="auth-intro">The link may be invalid or expired. Request a fresh link to continue.</p>
        <a class="sw-btn sw-btn-primary" asp-action="ForgotPassword">Request another link</a>
    </div>
</section>
