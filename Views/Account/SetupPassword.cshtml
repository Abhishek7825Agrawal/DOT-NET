@model SetupPasswordViewModel
@{
    ViewData["Title"] = "Activate Your Account";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="text-center mb-4">
            <div class="sw-kicker justify-content-center mb-2">
                <span class="sw-kicker-dot"></span> Shelfwise Library &bull; Account Activation
            </div>
            <h1 class="sw-title-display mb-2" style="font-size: 2.2rem;">Activate Your Account</h1>
            <p class="text-muted">Welcome, <strong style="color: var(--sw-navy);">@Model.FullName</strong>. Create a private password to complete your membership setup.</p>
        </div>

        <div class="sw-table-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom" style="border-color: var(--sw-border) !important;">
                <div class="sw-kpi-icon sw-icon-terracotta" style="width: 44px; height: 44px; font-size: 1.3rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <h3 class="h6 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Credential Setup</h3>
                    <small class="text-muted font-monospace">@Model.Email</small>
                </div>
            </div>

            <form asp-action="SetupPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-4 rounded-0" role="alert"></div>

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <!-- New Password -->
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--sw-navy);">
                        Create Password <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--sw-input-border);">
                            <i class="bi bi-key text-muted"></i>
                        </span>
                        <input asp-for="NewPassword" type="password" class="form-control border-start-0 ps-0 sw-input" id="newPasswordInput" placeholder="Min. 10 characters" autofocus />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Confirm Password -->
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--sw-navy);">
                        Confirm Password <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--sw-input-border);">
                            <i class="bi bi-check2-all text-muted"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0 sw-input" placeholder="Repeat your password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password Requirements Card -->
                <div class="p-3 mb-4 rounded-0" style="background-color: var(--sw-paper-warm, #fdfbf7); border: 1px solid var(--sw-border);">
                    <span class="fw-bold small d-block mb-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem; color: var(--sw-navy);">
                        Password Complexity Standards:
                    </span>
                    <ul class="list-unstyled mb-0 small text-muted" style="line-height: 1.8;">
                        <li><i class="bi bi-check2 text-muted me-1"></i> At least 10 characters in length</li>
                        <li><i class="bi bi-check2 text-muted me-1"></i> At least one uppercase letter (A-Z)</li>
                        <li><i class="bi bi-check2 text-muted me-1"></i> At least one lowercase letter (a-z)</li>
                        <li><i class="bi bi-check2 text-muted me-1"></i> At least one number (0-9)</li>
                        <li><i class="bi bi-check2 text-muted me-1"></i> At least one special symbol (!@@#$%^&amp;*)</li>
                    </ul>
                </div>

                <button type="submit" class="sw-btn sw-btn-accent w-100 py-3 mb-3">
                    <i class="bi bi-check2-circle me-1"></i> Activate Account &amp; Proceed to Login
                </button>
            </form>

            <div class="text-center pt-3 border-top" style="border-color: var(--sw-border) !important;">
                <span class="small text-muted">Already configured your password?</span>
                <a asp-action="Login" class="small fw-bold text-decoration-none ms-1" style="color: var(--sw-terracotta);">Sign In &rarr;</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
