@model IReadOnlyList<DigitalBookCardViewModel>
@{
    ViewData["Title"] = "Digital Library & Manuscript Reading Room";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker sw-kicker-forest"><i class="bi bi-file-earmark-pdf me-1"></i> PARCHMENT DIGITAL READING ROOM</div>
        <h1 class="sw-h1">Digital Manuscripts &amp; Workspace</h1>
        <p class="sw-body text-muted mb-0">Read complete digitized texts, highlight passages, and prepare research notes side-by-side in your scholar workspace.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-controller="Books" asp-action="Index">
            <i class="bi bi-bookshelf me-1"></i> Wooden Stacks
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <a class="sw-btn sw-btn-brass" asp-controller="AdminBooks" asp-action="Index">
                <i class="bi bi-gear me-1"></i> Digital Asset Desk
            </a>
        }
    </div>
</div>

<!-- Search & Category Filters -->
<form method="get" class="parchment-card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 border-warning border-opacity-50">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input class="form-control border-start-0 ps-0 sw-input" name="q" value="@ViewBag.Query" placeholder="Search digital manuscripts, authors, subjects..." aria-label="Search digital books" />
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select sw-input" name="category" aria-label="Filter by category">
                <option value="">All Archive Sections</option>
                @if (ViewBag.Categories is IEnumerable<string> categories)
                {
                    foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(string.Equals(cat, ViewBag.Category as string, StringComparison.OrdinalIgnoreCase))">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="sw-btn sw-btn-primary w-100" type="submit">Filter Stacks</button>
        </div>
    </div>
</form>

<!-- Digital Books Showcase Grid -->
@if (Model.Count == 0)
{
    <div class="sw-empty-state py-5">
        <div class="sw-empty-icon"><i class="bi bi-file-earmark-pdf"></i></div>
        <h3 class="sw-empty-title">No digital volumes found</h3>
        <p class="sw-empty-text">No digital manuscripts match your current query. Try adjusting your search or explore the wooden stacks.</p>
        <a asp-action="Index" class="sw-btn sw-btn-outline mt-2">Reset Filters</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="parchment-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Header badge row -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="brass-tag">@book.Category</span>
                            <span class="small sw-mono text-muted">
                                <i class="bi bi-files me-1"></i>@book.PageCount pages
                            </span>
                        </div>

                        <!-- Book Title & Author -->
                        <h3 class="h5 fw-bold mb-1" style="font-family: var(--sw-font-heading);">
                            <a asp-action="Workspace" asp-route-id="@book.DigitalBookId" class="text-decoration-none" style="color: var(--sw-walnut-deep);" target="_blank">
                                @book.Title
                            </a>
                        </h3>
                        <p class="small text-muted mb-3">by <strong style="color: var(--sw-text);">@book.Author</strong></p>

                        <!-- Excerpt / Description -->
                        <p class="small text-muted mb-4" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(book.Description) ? "Digital manuscript curated in the Shelfwise library collection. Full-text search and side-by-side annotation available." : book.Description)
                        </p>
                    </div>

                    <div>
                        <!-- Reading Progress Bar if active -->
                        @if (book.HasStartedReading && book.PercentComplete.HasValue)
                        {
                            <div class="mb-3 pt-2 border-top border-warning border-opacity-25">
                                <div class="d-flex justify-content-between small text-muted mb-1 sw-mono">
                                    <span>Reading Progress</span>
                                    <span class="fw-bold text-success">@book.PercentComplete.Value.ToString("0")%</span>
                                </div>
                                <div class="progress" style="height: 6px; background-color: var(--sw-bg-alt); border: 1px solid var(--sw-border-warm);">
                                    <div class="progress-bar bg-success" style="width: @book.PercentComplete.Value%;"></div>
                                </div>
                                <small class="text-muted d-block mt-1 sw-mono" style="font-size: 0.72rem;">Last paused on page @book.LastPageRead of @book.PageCount</small>
                            </div>
                        }

                        <!-- Action Toolbar -->
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top border-warning border-opacity-25">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="sw-btn sw-btn-sm sw-btn-outline" title="Inspect catalogue record">
                                <i class="bi bi-info-circle me-1"></i> Folio Card
                            </a>

                            <a asp-action="Workspace" asp-route-id="@book.DigitalBookId" class="sw-btn sw-btn-sm sw-btn-brass" target="_blank">
                                <i class="bi bi-layout-split me-1"></i>
                                @(book.HasStartedReading ? "Resume Reading" : "Open Workspace")
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
