@model UserNote
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title · Shelfwise Reading Notes</title>

    <!-- Typography: Playfair Display, DM Sans, DM Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300..800;1,9..40,300..800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'DM Sans', system-ui, sans-serif;
            background-color: #fdfbf7;
            color: #17243a;
            padding: 3rem 1.5rem;
            line-height: 1.8;
        }

        .export-sheet {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            padding: 4rem 3.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e5dfd2;
        }

        .brand-kicker {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #d96c45;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .note-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 2.2rem;
            margin-bottom: 0.5rem;
            color: #17243a;
        }

        .book-citation {
            font-size: 0.95rem;
            color: #6c757d;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #e5dfd2;
        }

        .note-content {
            font-size: 1.05rem;
        }

        .note-content blockquote {
            border-left: 4px solid #d96c45;
            background-color: rgba(217, 108, 69, 0.05);
            padding: 0.8rem 1.25rem;
            margin: 1.5rem 0;
            color: #555555;
            font-style: italic;
        }

        .note-content h1, .note-content h2, .note-content h3 {
            font-family: 'Playfair Display', serif;
            color: #17243a;
            margin-top: 2rem;
            margin-bottom: 0.75rem;
        }

        .print-toolbar {
            max-width: 800px;
            margin: 0 auto 1.5rem auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .export-sheet {
                box-shadow: none;
                border: none;
                padding: 0;
            }
            .print-toolbar {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <a href="javascript:window.close()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i> Close
        </a>
        <button type="button" class="btn btn-sm btn-dark" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / Save as PDF
        </button>
    </div>

    <main class="export-sheet">
        <div class="brand-kicker">Shelfwise Reading Workspace &bull; Personal Research Archive</div>
        <h1 class="note-title">@Model.Title</h1>
        <div class="book-citation">
            Reference Volume: <strong>@Model.Book.Title</strong> by <em>@Model.Book.Author</em> &bull; Last updated @Model.LastModifiedUtc.ToString("dd MMMM yyyy HH:mm") UTC
        </div>

        <article class="note-content">
            @Html.Raw(Model.SanitizedContentHtml)
        </article>
    </main>
</body>
</html>
