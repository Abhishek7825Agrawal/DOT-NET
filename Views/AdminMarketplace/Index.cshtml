@model AdminModerationViewModel
@{
    ViewData["Title"] = "Editorial Moderation Desk";
    var activeTab = (string)(ViewBag.ActiveTab ?? "pending");
}

<div class="sw-editorial-container pb-5">
    <!-- Header Section -->
    <section class="sw-page-header py-4 py-md-5 border-bottom mb-4" style="border-color: var(--sw-border) !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="sw-kicker sw-kicker-crimson">Editorial Oversight &amp; Compliance</span>
                <h1 class="sw-h1 display-5 mb-2" style="font-family: var(--sw-font-serif); font-weight: 700; color: var(--sw-navy);">
                    Editorial Moderation Desk<span class="text-danger">.</span>
                </h1>
                <p class="text-muted mb-0 fs-6">
                    Peer-review manuscript verification, copyright compliance management, and marketplace fee governance.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Marketplace" asp-action="Index" class="sw-btn sw-btn-outline">
                    <i class="bi bi-shop me-1"></i> Public Marketplace
                </a>
            </div>
        </div>
    </section>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tab Navigation -->
    <ul class="nav nav-pills sw-nav-tabs mb-4 gap-2" id="moderationTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link @(activeTab == "pending" ? "active" : "") fw-bold" href="?tab=pending">
                <i class="bi bi-hourglass-split me-1"></i> Pending Peer Review
                <span class="badge bg-warning text-dark ms-1">@Model.PendingPapers.Count</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(activeTab == "approved" ? "active" : "") fw-bold" href="?tab=approved">
                <i class="bi bi-patch-check-fill me-1"></i> Approved Catalogue
                <span class="badge bg-secondary ms-1">@Model.ApprovedPapers.Count</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link @(activeTab == "reports" ? "active" : "") fw-bold" href="?tab=reports">
                <i class="bi bi-shield-fill-exclamation me-1"></i> Copyright Claims
                <span class="badge bg-danger ms-1">@Model.CopyrightReports.Count</span>
            </a>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item" role="presentation">
                <a class="nav-link @(activeTab == "settings" ? "active" : "") fw-bold" href="?tab=settings">
                    <i class="bi bi-sliders me-1"></i> Commission Policies
                </a>
            </li>
        }
    </ul>

    <!-- Tab 1: Pending Peer Review -->
    @if (activeTab == "pending")
    {
        <div class="sw-table-card p-0 overflow-hidden mb-4">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--sw-border) !important;">
                <h2 class="h6 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Manuscripts Awaiting Editorial Decision</h2>
                <span class="badge bg-warning text-dark">@Model.PendingPapers.Count pending</span>
            </div>

            @if (!Model.PendingPapers.Any())
            {
                <div class="text-center py-5 px-4">
                    <div class="sw-kpi-icon sw-icon-teal mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.8rem;">
                        <i class="bi bi-check2-all"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-1" style="font-family: var(--sw-font-serif);">Editorial Queue is Clear</h3>
                    <p class="text-muted small mb-0">No research manuscripts are currently awaiting peer review.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                            <tr>
                                <th class="ps-4">Manuscript &amp; Author</th>
                                <th>Domain</th>
                                <th>Tier</th>
                                <th>Version</th>
                                <th>Submitted By</th>
                                <th>Submitted At</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var paper in Model.PendingPapers)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-navy" style="font-family: var(--sw-font-serif); font-size: 1rem;">
                                            @paper.Title
                                        </div>
                                        <small class="text-muted"><i class="bi bi-person me-1"></i>@paper.Authors &bull; @paper.Affiliation</small>
                                    </td>
                                    <td>
                                        <span class="sw-badge sw-badge-neutral">@paper.Category</span>
                                    </td>
                                    <td>
                                        @if (paper.IsPaid && paper.Price > 0m)
                                        {
                                            <span class="font-monospace fw-bold text-primary">₹@paper.Price.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="sw-badge sw-badge-success font-monospace">Open Access</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">v@paper.CurrentVersion</span>
                                    </td>
                                    <td class="small">
                                        @(paper.SubmitterUser?.Email ?? "Author")
                                    </td>
                                    <td class="text-muted small">
                                        @paper.SubmittedAtUtc.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Review" asp-route-id="@paper.Id" class="sw-btn sw-btn-primary sw-btn-sm">
                                            <i class="bi bi-search me-1"></i> Review Manuscript
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Tab 2: Approved Catalogue -->
    @if (activeTab == "approved")
    {
        <div class="sw-table-card p-0 overflow-hidden mb-4">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--sw-border) !important;">
                <h2 class="h6 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Published Research Catalogue</h2>
                <span class="badge bg-success">@Model.ApprovedPapers.Count active</span>
            </div>

            @if (!Model.ApprovedPapers.Any())
            {
                <div class="text-center py-5 px-4 text-muted">
                    No approved manuscripts currently listed.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                            <tr>
                                <th class="ps-4">Title &amp; Author</th>
                                <th>Domain</th>
                                <th>Tier</th>
                                <th>Version</th>
                                <th>Acquisitions</th>
                                <th>Approved</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var paper in Model.ApprovedPapers)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <a asp-controller="Marketplace" asp-action="Details" asp-route-id="@paper.Id" target="_blank" class="text-decoration-none fw-bold text-navy" style="font-family: var(--sw-font-serif);">
                                            @paper.Title
                                        </a>
                                        <small class="text-muted d-block"><i class="bi bi-person me-1"></i>@paper.Authors</small>
                                    </td>
                                    <td>
                                        <span class="sw-badge sw-badge-neutral">@paper.Category</span>
                                    </td>
                                    <td>
                                        @if (paper.IsPaid && paper.Price > 0m)
                                        {
                                            <span class="font-monospace fw-bold text-primary">₹@paper.Price.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="sw-badge sw-badge-success font-monospace">Open Access</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">v@paper.CurrentVersion</span>
                                    </td>
                                    <td class="small">
                                        <i class="bi bi-download me-1 text-muted"></i>@paper.DownloadCount
                                        @if (paper.IsPaid)
                                        {
                                            <span class="ms-2"><i class="bi bi-bag-check me-1 text-primary"></i>@paper.PurchaseCount</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(paper.ReviewedAtUtc?.ToLocalTime().ToString("MMM dd, yyyy") ?? "-")
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Review" asp-route-id="@paper.Id" class="sw-btn sw-btn-outline sw-btn-sm" title="Inspect version audit">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button type="button" class="sw-btn sw-btn-sm bg-danger text-white border-danger" data-bs-toggle="modal" data-bs-target="#suspendModal-@paper.Id" title="Suspend manuscript">
                                                <i class="bi bi-slash-circle me-1"></i> Suspend
                                            </button>
                                        </div>

                                        <!-- Suspend Modal -->
                                        <div class="modal fade" id="suspendModal-@paper.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <form asp-action="Suspend" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@paper.Id" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title text-danger" style="font-family: var(--sw-font-serif);">Suspend Manuscript</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="small text-muted mb-3">
                                                                Are you sure you want to suspend <strong>@paper.Title</strong>? It will immediately be delisted from the public marketplace.
                                                            </p>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-bold">Suspension Justification / Editorial Notes:</label>
                                                                <textarea name="reason" rows="3" class="form-control sw-input" placeholder="e.g., Copyright inquiry, methodology retraction, or policy violation."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="sw-btn sw-btn-outline sw-btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="sw-btn sw-btn-primary bg-danger border-danger sw-btn-sm">Confirm Suspension</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Tab 3: Copyright Claims (DMCA) -->
    @if (activeTab == "reports")
    {
        <div class="sw-table-card p-0 overflow-hidden mb-4">
            <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--sw-border) !important;">
                <h2 class="h6 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Intellectual Property &amp; DMCA Infringement Claims</h2>
                <span class="badge bg-danger">@Model.CopyrightReports.Count claims</span>
            </div>

            @if (!Model.CopyrightReports.Any())
            {
                <div class="text-center py-5 px-4 text-muted">
                    <i class="bi bi-shield-check fs-2 text-success d-block mb-2"></i>
                    No copyright or intellectual property disputes on record.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                            <tr>
                                <th class="ps-4">Claim Ref</th>
                                <th>Challenged Manuscript</th>
                                <th>Claimant Details</th>
                                <th>Alleged Original Work</th>
                                <th>Status</th>
                                <th>Filed Date</th>
                                <th class="text-end pe-4">Resolution</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.CopyrightReports)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <code class="font-monospace fw-bold text-danger">#@report.Id</code>
                                    </td>
                                    <td>
                                        <a asp-controller="Marketplace" asp-action="Details" asp-route-id="@report.PaperId" target="_blank" class="fw-bold text-decoration-none text-navy">
                                            @report.Paper.Title
                                        </a>
                                    </td>
                                    <td class="small">
                                        <div class="fw-bold">@report.ReporterName</div>
                                        <a href="mailto:@report.ReporterEmail" class="text-muted">@report.ReporterEmail</a>
                                    </td>
                                    <td class="small">
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@report.InfringedWorkTitle">
                                            @report.InfringedWorkTitle
                                        </span>
                                    </td>
                                    <td>
                                        @switch (report.Status)
                                        {
                                            case CopyrightReportStatus.UnderReview:
                                                <span class="sw-badge sw-badge-warning">Under Review</span>
                                                break;
                                            case CopyrightReportStatus.UpheldSuspended:
                                                <span class="sw-badge sw-badge-danger">Upheld (Suspended)</span>
                                                break;
                                            case CopyrightReportStatus.Dismissed:
                                                <span class="sw-badge sw-badge-success">Dismissed</span>
                                                break;
                                            default:
                                                <span class="sw-badge sw-badge-neutral">@report.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @report.ReportedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (report.Status == CopyrightReportStatus.UnderReview)
                                        {
                                            <button type="button" class="sw-btn sw-btn-primary sw-btn-sm" data-bs-toggle="modal" data-bs-target="#resolveReport-@report.Id">
                                                Resolve Claim
                                            </button>

                                            <!-- Modal to resolve claim -->
                                            <div class="modal fade" id="resolveReport-@report.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered text-start">
                                                    <div class="modal-content">
                                                        <form asp-action="ResolveCopyrightReport" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="reportId" value="@report.Id" />
                                                            <div class="modal-header">
                                                                <h5 class="modal-title" style="font-family: var(--sw-font-serif);">Resolve DMCA Claim #@report.Id</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-bold">Infringement Allegation:</label>
                                                                    <div class="p-2 bg-light rounded border small font-monospace text-muted" style="white-space: pre-wrap;">@report.InfringementDescription</div>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-bold">Editorial Board Ruling:</label>
                                                                    <select name="decision" class="form-select sw-input">
                                                                        <option value="uphold">Uphold Claim &amp; Suspend Manuscript</option>
                                                                        <option value="dismiss">Dismiss Claim (Work is Original / Fair Use)</option>
                                                                    </select>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label small fw-bold">Decision Remarks / Audit Note:</label>
                                                                    <textarea name="remarks" rows="3" class="form-control sw-input" placeholder="Explain findings of comparative analysis or peer investigation..."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="sw-btn sw-btn-outline sw-btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="sw-btn sw-btn-primary sw-btn-sm">Submit Ruling</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Resolved @(report.ResolvedAtUtc?.ToLocalTime().ToString("MMM dd"))</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- Tab 4: Commission Policies & Settings -->
    @if (activeTab == "settings" && User.IsInRole("Admin"))
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="sw-table-card p-4 p-md-5 mb-4">
                    <span class="sw-kicker sw-kicker-navy">Platform Financial Governance</span>
                    <h2 class="h4 fw-bold mb-3" style="font-family: var(--sw-font-serif);">
                        Marketplace Policy &amp; Platform Commission<span class="text-primary">.</span>
                    </h2>
                    <p class="text-muted small mb-4">
                        Define marketplace commission deductions and listing constraints. These settings apply dynamically to newly created author sales ledgers.
                    </p>

                    <form asp-action="UpdateSettings" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase" style="letter-spacing: 0.05em;">Platform Commission Rate (%) *</label>
                            <div class="input-group">
                                <input name="PlatformCommissionRate" type="number" step="0.1" min="0" max="50" class="form-control sw-input font-monospace" value="@Model.Settings.PlatformCommissionRate" />
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">The percentage retained by Shelfwise on each paid manuscript acquisition (e.g., 15.0%).</small>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-uppercase" style="letter-spacing: 0.05em;">Minimum Listing Price (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input name="MinimumListingPrice" type="number" step="0.01" min="0" class="form-control sw-input font-monospace" value="@Model.Settings.MinimumListingPrice" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-uppercase" style="letter-spacing: 0.05em;">Maximum Listing Price (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input name="MaximumListingPrice" type="number" step="0.01" min="0" class="form-control sw-input font-monospace" value="@Model.Settings.MaximumListingPrice" />
                                </div>
                            </div>
                        </div>

                        <div class="form-check p-3 rounded mb-4" style="background-color: var(--sw-bg-alt, #f8f9fa); border: 1px solid var(--sw-border);">
                            <input name="RequireAdminApproval" class="form-check-input ms-0 me-2" type="checkbox" value="true" @(Model.Settings.RequireAdminApproval ? "checked" : "") id="approvalSwitch" />
                            <input type="hidden" name="RequireAdminApproval" value="false" />
                            <label class="form-check-label small" for="approvalSwitch">
                                <strong>Enforce Editorial Peer Review:</strong> All new submissions and major revisions require explicit Admin or Staff approval before appearing in the public catalogue.
                            </label>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="sw-btn sw-btn-primary px-4 py-2">
                                <i class="bi bi-save me-1"></i> Update Marketplace Policies
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
