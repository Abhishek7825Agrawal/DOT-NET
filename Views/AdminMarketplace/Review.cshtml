@model PaperReviewViewModel
@{
    ViewData["Title"] = "Editorial Review - " + Model.Paper.Title;
}

<div class="sw-editorial-container py-4 pb-5">
    <nav class="pb-3" aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Editorial Moderation Desk</a></li>
            <li class="breadcrumb-item active" aria-current="page">Manuscript Inspection</li>
        </ol>
    </nav>

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Banner -->
    <section class="py-4 border-bottom mb-4" style="border-color: var(--sw-border) !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="sw-badge sw-badge-neutral">@Model.Paper.Category</span>
                    @switch (Model.Paper.Status)
                    {
                        case PaperStatus.Approved:
                            <span class="sw-badge sw-badge-success">Approved / Live</span>
                            break;
                        case PaperStatus.PendingReview:
                            <span class="sw-badge sw-badge-warning">Pending Review</span>
                            break;
                        case PaperStatus.CorrectionRequested:
                            <span class="sw-badge sw-badge-accent">Correction Requested</span>
                            break;
                        case PaperStatus.Rejected:
                            <span class="sw-badge sw-badge-danger">Rejected</span>
                            break;
                        case PaperStatus.Suspended:
                            <span class="badge bg-dark text-white">Suspended</span>
                            break;
                    }
                    <span class="badge bg-light text-dark border">Version @Model.Paper.CurrentVersion</span>
                </div>
                <h1 class="display-6 fw-bold mb-2" style="font-family: var(--sw-font-serif); color: var(--sw-navy);">
                    @Model.Paper.Title
                </h1>
                <div class="text-muted small">
                    <span><i class="bi bi-person me-1"></i><strong>@Model.Paper.Authors</strong></span>
                    <span class="mx-2">&bull;</span>
                    <span><i class="bi bi-building me-1"></i>@Model.Paper.Affiliation</span>
                    <span class="mx-2">&bull;</span>
                    <span><i class="bi bi-calendar3 me-1"></i>Published: @Model.Paper.PublicationYear</span>
                    <span class="mx-2">&bull;</span>
                    <span><i class="bi bi-person-check me-1"></i>Submitter: @(Model.Paper.SubmitterUser?.Email ?? "Author")</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Marketplace" asp-action="Stream" asp-route-id="@Model.Paper.Id" target="_blank" class="sw-btn sw-btn-primary px-3">
                    <i class="bi bi-file-earmark-pdf me-1"></i> Inspect PDF Manuscript
                </a>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <!-- Main Column: Abstract, File Info, Versions -->
        <div class="col-lg-8">
            <!-- Academic Abstract -->
            <div class="sw-table-card p-4 mb-4">
                <h2 class="h6 text-uppercase fw-bold pb-2 border-bottom mb-3" style="letter-spacing: 0.05em; border-color: var(--sw-border) !important;">
                    Academic Abstract
                </h2>
                <div style="font-family: var(--sw-font-serif); font-size: 1.05rem; line-height: 1.8; color: #2d3748; white-space: pre-line;">
                    @Model.Paper.Abstract
                </div>
            </div>

            <!-- PDF Document Storage Details -->
            <div class="sw-table-card p-4 mb-4">
                <h2 class="h6 text-uppercase fw-bold pb-2 border-bottom mb-3" style="letter-spacing: 0.05em; border-color: var(--sw-border) !important;">
                    Document Integrity &amp; Cryptographic Storage
                </h2>
                <div class="row g-3 small">
                    <div class="col-sm-6">
                        <div class="text-muted">Storage Path:</div>
                        <div class="font-monospace text-dark">App_Data/MarketplacePapers/</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted">File Name (Sanitized GUID):</div>
                        <div class="font-monospace text-dark">@Model.Paper.StorageFileName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted">Original Upload Name:</div>
                        <div class="font-monospace text-dark">@Model.Paper.OriginalFileName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted">Page Count / Size:</div>
                        <div>@Model.Paper.PageCount pages &bull; @((Model.Paper.FileSizeBytes / 1024.0 / 1024.0).ToString("F2")) MB</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted">SHA-256 Checksum:</div>
                        <div class="font-monospace small p-2 bg-light rounded border text-break">@Model.Paper.ChecksumSha256</div>
                    </div>
                </div>
            </div>

            <!-- Immutable Version History -->
            <div class="sw-table-card p-0 overflow-hidden mb-4">
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--sw-border) !important;">
                    <h2 class="h6 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Immutable Version History Audit</h2>
                    <span class="badge bg-light text-muted border">@Model.Versions.Count versions</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light text-uppercase" style="letter-spacing: 0.05em; font-size: 0.7rem;">
                            <tr>
                                <th class="ps-3">Version</th>
                                <th>Timestamp</th>
                                <th>Pages</th>
                                <th>File Name</th>
                                <th>Change Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Versions)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">v@v.VersionNumber</td>
                                    <td class="text-muted">@v.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@v.PageCount</td>
                                    <td><span class="font-monospace">@v.OriginalFileName</span></td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(v.ChangeSummary) ? "Initial publication draft" : v.ChangeSummary)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar Column: Metadata & Decision Box -->
        <div class="col-lg-4">
            <!-- Metadata Card -->
            <div class="sw-table-card p-4 mb-4">
                <h2 class="h6 text-uppercase fw-bold pb-2 border-bottom mb-3" style="letter-spacing: 0.05em; border-color: var(--sw-border) !important;">
                    Publication Properties
                </h2>
                <div class="d-flex flex-column gap-3 small">
                    <div>
                        <span class="text-muted d-block">Tier / Commercial Listing:</span>
                        @if (Model.Paper.IsPaid && Model.Paper.Price > 0m)
                        {
                            <span class="fs-5 fw-bold font-monospace text-primary">₹@Model.Paper.Price.ToString("F2")</span>
                        }
                        else
                        {
                            <span class="sw-badge sw-badge-success font-monospace">Open Access (Free)</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Paper.Doi))
                    {
                        <div>
                            <span class="text-muted d-block">DOI Citation:</span>
                            <code class="font-monospace text-dark">@Model.Paper.Doi</code>
                        </div>
                    }

                    <div>
                        <span class="text-muted d-block">Keywords:</span>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var kw in Model.Paper.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <span class="badge bg-light text-muted border">@kw</span>
                            }
                        </div>
                    </div>

                    <div>
                        <span class="text-muted d-block">Copyright Warranty:</span>
                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Accepted by Author</span>
                    </div>
                </div>
            </div>

            <!-- Editorial Decision Action Box -->
            <div class="sw-table-card p-4 mb-4">
                <h2 class="h6 text-uppercase fw-bold pb-2 border-bottom mb-3" style="letter-spacing: 0.05em; border-color: var(--sw-border) !important;">
                    Editorial Decision
                </h2>

                <!-- 1. Approve Button -->
                <form asp-action="Approve" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Paper.Id" />
                    <button type="submit" class="sw-btn sw-btn-primary w-100 py-2 justify-content-center" onclick="return confirm('Approve and publish this research manuscript?');">
                        <i class="bi bi-check2-circle me-1"></i> Approve &amp; Publish
                    </button>
                </form>

                <!-- 2. Request Corrections Accordion/Button -->
                <button class="sw-btn sw-btn-outline w-100 mb-2 justify-content-center" type="button" data-bs-toggle="collapse" data-bs-target="#correctionCollapse">
                    <i class="bi bi-pencil-square me-1"></i> Request Corrections
                </button>
                <div class="collapse mb-3" id="correctionCollapse">
                    <form asp-action="RequestCorrections" method="post" class="p-3 bg-light rounded border mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Paper.Id" />
                        <label class="form-label small fw-bold">Required Revisions / Peer Feedback:</label>
                        <textarea name="feedback" rows="3" class="form-control sw-input mb-2" placeholder="Detail specific revisions required before publication..."></textarea>
                        <button type="submit" class="sw-btn sw-btn-sm sw-btn-primary w-100">Send Correction Request</button>
                    </form>
                </div>

                <!-- 3. Reject Accordion/Button -->
                <button class="sw-btn sw-btn-outline text-danger border-danger w-100 justify-content-center" type="button" data-bs-toggle="collapse" data-bs-target="#rejectCollapse">
                    <i class="bi bi-x-circle me-1"></i> Reject Manuscript
                </button>
                <div class="collapse mt-2" id="rejectCollapse">
                    <form asp-action="Reject" method="post" class="p-3 bg-light rounded border mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Paper.Id" />
                        <label class="form-label small fw-bold text-danger">Rejection Reason (Mandatory):</label>
                        <textarea name="reason" rows="3" class="form-control sw-input mb-2" placeholder="Explain basis of rejection (e.g. out of scope, failed methodology, unsubstantiated claims)..."></textarea>
                        <button type="submit" class="sw-btn sw-btn-sm sw-btn-primary bg-danger border-danger w-100">Confirm Rejection</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
