@model Book
@{
    ViewData["Title"] = Model.Title;
    var isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("Staff");
}

<!-- Breadcrumbs & Navigation Back -->
<div class="sw-page-header mb-4">
    <div class="sw-page-title-group">
        <nav class="sw-breadcrumbs" aria-label="Breadcrumbs">
            <a asp-action="Index">Archive Catalogue</a>
            <span class="sw-crumb-separator">&rsaquo;</span>
            <span>@Model.Category</span>
            <span class="sw-crumb-separator">&rsaquo;</span>
            <span class="sw-crumb-current text-truncate" style="max-width:240px">@Model.Title</span>
        </nav>
        <span class="sw-kicker sw-kicker-forest"><i class="bi bi-journal-bookmark-fill me-1"></i> ARCHIVAL FOLIO RECORD #BK-@Model.Id.ToString("D5")</span>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Return to Bookshelf
        </a>
        @if (isAdminOrStaff && Model.AvailableQuantity > 0)
        {
            <a class="sw-btn sw-btn-brass" asp-controller="AdminCirculation" asp-action="Issue" asp-route-bookId="@Model.Id">
                <i class="bi bi-box-arrow-up-right"></i> Issue This Volume
            </a>
        }
    </div>
</div>

<!-- Immersive Antique Library Folio Hero Section -->
<section class="sw-book-detail-hero sw-fade-in-up" aria-labelledby="book-title">
    <div class="sw-book-detail-grid">
        <!-- Leather Bound Cover Presentation -->
        <div class="sw-book-detail-cover">
            <div class="sw-book-cover-placeholder" style="width:100%;height:100%;min-height:380px;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="sw-placeholder-spine"><i class="bi bi-award-fill me-1"></i> @Model.Category</span>
                    <span class="brass-tag">#@Model.Id.ToString("D4")</span>
                </div>
                <div class="my-auto">
                    <h2 class="sw-placeholder-title" style="font-size: 1.55rem; color: #fff8e9;">@Model.Title</h2>
                    <div class="sw-placeholder-author mt-2" style="color: #dfbd78;">Authored by @Model.Author</div>
                </div>
                <div class="pt-3 border-top border-warning border-opacity-25 d-flex justify-content-between align-items-center">
                    <span class="small" style="color: #ebd193; font-family: var(--sw-font-mono);">@(Model.Publisher ?? "Shelfwise University Press")</span>
                    @if (Model.PublicationYear.HasValue)
                    {
                        <span class="small fw-bold" style="color: #dfbd78;">@Model.PublicationYear</span>
                    }
                </div>
            </div>
        </div>

        <!-- Book Metadata and Archival Information -->
        <div class="sw-book-detail-meta">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="brass-tag">@Model.Category</span>
                @if (Model.AvailableQuantity > 0)
                {
                    <span class="sw-badge sw-badge-success">
                        <span class="sw-badge-dot"></span> In Stack: @Model.AvailableQuantity Copies Available
                    </span>
                }
                else
                {
                    <span class="sw-badge sw-badge-danger">
                        <span class="sw-badge-dot"></span> All Copies Currently On Loan
                    </span>
                }
            </div>

            <h1 class="sw-book-detail-title" id="book-title">@Model.Title</h1>
            <div class="sw-book-detail-author">
                Preserved work of scholarship by <em>@Model.Author</em>
            </div>

            <!-- Specs Strip -->
            <div class="sw-book-specs-strip">
                <div class="sw-spec-item">
                    <span class="sw-spec-label">ISBN Identifier</span>
                    <span class="sw-spec-value sw-mono">@(Model.Isbn ?? "N/A")</span>
                </div>
                <div class="sw-spec-item">
                    <span class="sw-spec-label">Publishing House</span>
                    <span class="sw-spec-value">@(Model.Publisher ?? "Shelfwise Press")</span>
                </div>
                <div class="sw-spec-item">
                    <span class="sw-spec-label">Edition Year</span>
                    <span class="sw-spec-value sw-mono">@(Model.PublicationYear?.ToString() ?? "—")</span>
                </div>
                <div class="sw-spec-item">
                    <span class="sw-spec-label">Archive Copies</span>
                    <span class="sw-spec-value sw-mono">@Model.AvailableQuantity of @Model.TotalQuantity Available</span>
                </div>
            </div>

            <!-- Synopsis / Summary -->
            <div class="sw-book-detail-desc">
                @(string.IsNullOrWhiteSpace(Model.Description) 
                    ? "A catalogued monograph preserved in the Shelfwise library collection. Available for cardholder borrowing, academic research, and reading room circulation." 
                    : Model.Description)
            </div>

            <!-- Action Toolbar -->
            <div class="d-flex align-items-center gap-3 pt-2 flex-wrap">
                @if (Model.DigitalEdition != null && Model.DigitalEdition.IsDigitalAvailable)
                {
                    <a class="sw-btn sw-btn-brass" asp-controller="DigitalLibrary" asp-action="Workspace" asp-route-id="@Model.DigitalEdition.Id">
                        <i class="bi bi-layout-split me-1"></i> Read Online &amp; Take Notes
                    </a>
                }
                @if (isAdminOrStaff && Model.AvailableQuantity > 0)
                {
                    <a class="sw-btn sw-btn-forest" asp-controller="AdminCirculation" asp-action="Issue" asp-route-bookId="@Model.Id">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Issue Physical Volume
                    </a>
                }
                else if (User.IsInRole("Member") && Model.AvailableQuantity > 0)
                {
                    <span class="brass-tag py-2 px-3">
                        <i class="bi bi-check-circle me-1"></i> Available at Circulation Desk
                    </span>
                }
                @if (isAdminOrStaff)
                {
                    <a class="sw-btn sw-btn-outline" asp-controller="AdminBooks" asp-action="ManageDigital" asp-route-id="@Model.Id">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Digital Asset Desk
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="sw-btn sw-btn-outline" asp-controller="AdminBooks" asp-action="Edit" asp-route-id="@Model.Id">
                        <i class="bi bi-pencil me-1"></i> Edit Catalogue Record
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<!-- Additional Archival Record Information -->
<div class="row g-4">
    <div class="col-lg-6">
        <section class="parchment-card h-100">
            <span class="sw-kicker sw-kicker-forest"><i class="bi bi-boxes"></i> Inventory &amp; Stack Ledger</span>
            <h3 class="sw-h3 mb-3">Volume Availability</h3>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small">Stack Reserve</span>
                <span class="sw-mono small fw-bold">@Model.AvailableQuantity / @Model.TotalQuantity Available</span>
            </div>
            @{
                var pct = Model.TotalQuantity > 0 ? Math.Clamp((int)Math.Round((double)Model.AvailableQuantity / Model.TotalQuantity * 100), 0, 100) : 0;
            }
            <div class="progress mb-4" style="height: 10px; background-color: var(--sw-bg-alt); border: 1px solid var(--sw-border-warm);">
                <div class="progress-bar @(Model.AvailableQuantity > 0 ? "bg-success" : "bg-danger")" style="width: @pct%;"></div>
            </div>
            <p class="small text-muted mb-0">
                Library policy enforces a standard 14-day borrowing loan for all physical catalogued items with daily overdue fees applicable beyond due dates.
            </p>
        </section>
    </div>

    <div class="col-lg-6">
        <section class="parchment-card h-100">
            <span class="sw-kicker sw-kicker-forest"><i class="bi bi-tag-fill"></i> Catalogue Specifications</span>
            <h3 class="sw-h3 mb-3">Archival Folio Metadata</h3>
            <dl class="row small mb-0">
                <dt class="col-sm-4 text-muted">Internal Record ID</dt>
                <dd class="col-sm-8 sw-mono">#BK-@Model.Id.ToString("D5")</dd>

                <dt class="col-sm-4 text-muted">Subject Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4 text-muted">Archive Status</dt>
                <dd class="col-sm-8">@(Model.IsActive ? "Active Catalogued Item" : "Archived Volume")</dd>

                <dt class="col-sm-4 text-muted">Archived On</dt>
                <dd class="col-sm-8 sw-mono">@Model.AddedAtUtc.ToString("dd MMMM yyyy")</dd>
            </dl>
        </section>
    </div>
</div>
