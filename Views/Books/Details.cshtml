@model Book
@{
    ViewData["Title"] = Model.Title;
    var isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("Staff");
}

@functions {
    string GetThemeClass(string? category, int id)
    {
        string[] themes = [
            "cover-theme-saffron",
            "cover-theme-cobalt",
            "cover-theme-sage",
            "cover-theme-crimson",
            "cover-theme-charcoal",
            "cover-theme-plum",
            "cover-theme-terracotta",
            "cover-theme-teal"
        ];
        var seed = Math.Abs((category?.GetHashCode(StringComparison.OrdinalIgnoreCase) ?? 0) * 31 + id);
        return themes[seed % themes.Length];
    }
}

<!-- Breadcrumbs & Navigation Back -->
<div class="sw-page-header mb-4">
    <div class="sw-page-title-group">
        <nav class="sw-breadcrumbs" aria-label="Breadcrumbs">
            <a asp-action="Index">Catalogue</a>
            <span class="sw-crumb-separator">/</span>
            <span class="sw-crumb-current">@Model.Category</span>
            <span class="sw-crumb-separator">/</span>
            <span class="sw-crumb-current text-truncate" style="max-width:200px">@Model.Title</span>
        </nav>
        <span class="sw-kicker">Archival Record</span>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Back to Collection
        </a>
        @if (isAdminOrStaff && Model.AvailableQuantity > 0)
        {
            <a class="sw-btn sw-btn-accent" asp-controller="AdminCirculation" asp-action="Issue" asp-route-bookId="@Model.Id">
                <i class="bi bi-plus-circle"></i> Issue This Title
            </a>
        }
    </div>
</div>

<!-- Immersive Dark Book-Cover Hero Section -->
<section class="sw-book-detail-hero sw-fade-in-up" aria-labelledby="book-title">
    <div class="sw-book-detail-grid">
        <!-- 3:4 Cover Presentation -->
        <div class="sw-book-detail-cover">
            <div class="editorial-book-cover @GetThemeClass(Model.Category, Model.Id)" style="width:100%;height:100%;min-height:360px;">
                <div class="cover-spine-edge"></div>
                <div class="cover-header">
                    <span class="cover-tag"><i class="bi bi-bookmark-fill me-1"></i> @Model.Category</span>
                    <span class="cover-seal"><i class="bi bi-book-half"></i></span>
                </div>
                <div class="cover-body">
                    <h3 class="cover-title">@Model.Title</h3>
                </div>
                <div class="cover-footer">
                    <div class="cover-rule"></div>
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <span class="cover-author">@Model.Author</span>
                        @if (Model.PublicationYear.HasValue)
                        {
                            <span class="cover-year">@Model.PublicationYear</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Book Metadata and Archival Information -->
        <div class="sw-book-detail-meta">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="sw-badge sw-badge-neutral">@Model.Category</span>
                @if (Model.AvailableQuantity > 0)
                {
                    <span class="sw-badge sw-badge-success">
                        <span class="sw-badge-dot"></span> In Stock: @Model.AvailableQuantity Available
                    </span>
                }
                else
                {
                    <span class="sw-badge sw-badge-danger">
                        <span class="sw-badge-dot"></span> All Copies Currently on Loan
                    </span>
                }
            </div>

            <h1 class="sw-book-detail-title" id="book-title">@Model.Title</h1>
            <div class="sw-book-detail-author">
                Authored by <em>@Model.Author</em>
            </div>

            <!-- Specs Strip -->
            <div class="sw-book-specs-strip">
                <div class="sw-spec-item">
                    <span class="sw-spec-label">ISBN</span>
                    <span class="sw-spec-value sw-mono">@(Model.Isbn ?? "N/A")</span>
                </div>
                <div class="sw-spec-item">
                    <span class="sw-spec-label">Publisher</span>
                    <span class="sw-spec-value">@(Model.Publisher ?? "Editorial Press")</span>
                </div>
                <div class="sw-spec-item">
                    <span class="sw-spec-label">Published</span>
                    <span class="sw-spec-value sw-mono">@(Model.PublicationYear?.ToString() ?? "—")</span>
                </div>
                <div class="sw-spec-item">
                    <span class="sw-spec-label">Shelf Copies</span>
                    <span class="sw-spec-value sw-mono">@Model.AvailableQuantity of @Model.TotalQuantity</span>
                </div>
            </div>

            <!-- Synopsis / Summary -->
            <div class="sw-book-detail-desc">
                @(string.IsNullOrWhiteSpace(Model.Description) 
                    ? "A catalogued monograph preserved in the Shelfwise library collection. Available for cardholder borrowing, academic research, and reading room circulation." 
                    : Model.Description)
            </div>

            <!-- Action Toolbar -->
            <div class="d-flex align-items-center gap-3 pt-2 flex-wrap">
                @if (Model.DigitalEdition != null && Model.DigitalEdition.IsDigitalAvailable)
                {
                    <a class="sw-btn sw-btn-accent" asp-controller="DigitalLibrary" asp-action="Workspace" asp-route-id="@Model.DigitalEdition.Id">
                        <i class="bi bi-layout-split me-1"></i> Read Online &amp; Take Notes
                    </a>
                }
                @if (isAdminOrStaff && Model.AvailableQuantity > 0)
                {
                    <a class="sw-btn sw-btn-outline" asp-controller="AdminCirculation" asp-action="Issue" asp-route-bookId="@Model.Id">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Issue Physical Copy
                    </a>
                }
                else if (User.IsInRole("Member") && Model.AvailableQuantity > 0)
                {
                    <span class="sw-badge sw-badge-success py-2 px-3">
                        <i class="bi bi-check-circle me-1"></i> Physical copy available at desk
                    </span>
                }
                @if (isAdminOrStaff)
                {
                    <a class="sw-btn sw-btn-outline" asp-controller="AdminBooks" asp-action="ManageDigital" asp-route-id="@Model.Id">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Manage Digital Asset
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="sw-btn sw-btn-outline" asp-controller="AdminBooks" asp-action="Edit" asp-route-id="@Model.Id">
                        <i class="bi bi-pencil me-1"></i> Edit Record
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<!-- Additional Technical Record Information -->
<div class="row g-4">
    <div class="col-lg-6">
        <section class="sw-table-card p-4 h-100">
            <span class="sw-kicker">Inventory &amp; Archival Tracking</span>
            <h3 class="sw-h3 mb-3">Copy Availability</h3>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small">Circulation Level</span>
                <span class="sw-mono small fw-bold">@Model.AvailableQuantity / @Model.TotalQuantity Available</span>
            </div>
            @{
                var pct = Model.TotalQuantity > 0 ? Math.Clamp((int)Math.Round((double)Model.AvailableQuantity / Model.TotalQuantity * 100), 0, 100) : 0;
            }
            <div class="progress mb-4" style="height: 10px; background-color: var(--sw-bg-alt);">
                <div class="progress-bar @(Model.AvailableQuantity > 0 ? "bg-success" : "bg-danger")" style="width: @pct%;"></div>
            </div>
            <p class="small text-muted mb-0">
                Library policy enforces maximum 14-day loan terms for all catalogued items with daily overdue fees applicable beyond due dates.
            </p>
        </section>
    </div>

    <div class="col-lg-6">
        <section class="sw-table-card p-4 h-100">
            <span class="sw-kicker">Catalogue Record Metadata</span>
            <h3 class="sw-h3 mb-3">Archival Specifications</h3>
            <dl class="row small mb-0">
                <dt class="col-sm-4 text-muted">Internal Record ID</dt>
                <dd class="col-sm-8 sw-mono">#BK-@Model.Id.ToString("D5")</dd>

                <dt class="col-sm-4 text-muted">Subject Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4 text-muted">Status</dt>
                <dd class="col-sm-8">@(Model.IsActive ? "Active Catalogued Item" : "Archived")</dd>

                <dt class="col-sm-4 text-muted">Catalogued On</dt>
                <dd class="col-sm-8 sw-mono">@Model.AddedAtUtc.ToString("dd MMMM yyyy")</dd>
            </dl>
        </section>
    </div>
</div>
