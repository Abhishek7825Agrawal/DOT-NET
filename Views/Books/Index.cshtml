@model IReadOnlyList<Book>
@{
    ViewData["Title"] = "Wooden Bookshelf & Archive Catalogue";
}

@functions {
    string GetSpineColor(string? category, int id)
    {
        string[] colors = [
            "walnut",
            "navy",
            "forest",
            "burgundy",
            "leather-red",
            "ochre",
            "midnight"
        ];
        var seed = Math.Abs((category?.GetHashCode(StringComparison.OrdinalIgnoreCase) ?? 0) * 31 + id);
        return colors[seed % colors.Length];
    }

    string GetSpineHeightClass(int id)
    {
        string[] heights = ["spine-height-sm", "spine-height-md", "spine-height-lg", "spine-height-xl"];
        return heights[Math.Abs(id * 17) % heights.Length];
    }

    string GetSpineWidthClass(int id)
    {
        string[] widths = ["spine-width-sm", "spine-width-md", "spine-width-lg", "spine-width-xl"];
        return widths[Math.Abs(id * 23) % widths.Length];
    }
}

<!-- Warm Archive Catalogue Header -->
<div class="sw-page-header mb-4">
    <div class="sw-page-title-group">
        <div class="sw-kicker sw-kicker-forest"><i class="bi bi-bookshelf"></i> SHELFWISE GRAND ARCHIVE</div>
        <h1 class="sw-h1">The Bookshelf Catalogue</h1>
        <p class="sw-body text-muted mb-0">
            Browsing <strong>@ViewBag.TotalCatalogueCount</strong> catalogued volumes arranged on wooden library stacks.
            @if ((int)ViewBag.FilteredCount != (int)ViewBag.TotalCatalogueCount)
            {
                <span class="brass-tag ms-2">@ViewBag.FilteredCount matching filters</span>
            }
        </p>
    </div>
    <div class="sw-page-actions">
        <!-- View Mode Switcher -->
        <div class="sw-view-toggle-group me-2" role="group" aria-label="Catalogue view format">
            <button type="button" class="sw-view-toggle-btn active" id="btnViewShelf" onclick="setCatalogueView('shelf')" title="Wooden Bookshelf (Spine View)">
                <i class="bi bi-bookshelf"></i> <span class="d-none d-sm-inline">Spine Shelf</span>
            </button>
            <button type="button" class="sw-view-toggle-btn" id="btnViewGrid" onclick="setCatalogueView('grid')" title="Card Catalog View">
                <i class="bi bi-grid-3x3-gap"></i> <span class="d-none d-sm-inline">Card Catalog</span>
            </button>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <a asp-controller="AdminBooks" asp-action="Create" class="sw-btn sw-btn-primary sw-btn-sm">
                <i class="bi bi-plus-lg"></i> Add New Book
            </a>
            <a asp-controller="AdminCirculation" asp-action="Issue" class="sw-btn sw-btn-outline sw-btn-sm">
                <i class="bi bi-box-arrow-up-right"></i> Issue Desk
            </a>
        }
    </div>
</div>

<!-- Search, Availability, & Sorting Bar -->
<div class="sw-catalogue-toolbar mb-4">
    <form method="get" class="w-100 d-flex flex-wrap align-items-center justify-content-between gap-3" id="catalogueSearchForm">
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Category))
        {
            <input type="hidden" name="category" value="@ViewBag.Category" />
        }

        <!-- Search input -->
        <div class="sw-catalogue-search-form">
            <div class="position-relative w-100">
                <input type="search" class="sw-input" id="q" name="q" value="@ViewBag.Query"
                       placeholder="Search shelves by title, author, call number or ISBN..."
                       aria-label="Search catalogue" />
                @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Query))
                {
                    <a asp-action="Index" asp-route-category="@ViewBag.Category" asp-route-availability="@ViewBag.Availability" asp-route-sort="@ViewBag.Sort" 
                       class="position-absolute end-0 top-50 translate-middle-y me-3 text-muted text-decoration-none" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </a>
                }
            </div>
        </div>

        <!-- Availability Filter -->
        <div class="d-flex align-items-center gap-1 bg-surface border rounded p-1">
            <a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category" asp-route-sort="@ViewBag.Sort"
               class="sw-btn sw-btn-sm @(string.IsNullOrWhiteSpace((string?)ViewBag.Availability) ? "sw-btn-primary" : "sw-btn-outline")">
                All Volumes
            </a>
            <a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category" asp-route-availability="available" asp-route-sort="@ViewBag.Sort"
               class="sw-btn sw-btn-sm @((string?)ViewBag.Availability == "available" ? "sw-btn-primary" : "sw-btn-outline")">
                <i class="bi bi-check2"></i> Available
            </a>
            <a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category" asp-route-availability="issued" asp-route-sort="@ViewBag.Sort"
               class="sw-btn sw-btn-sm @((string?)ViewBag.Availability == "issued" ? "sw-btn-primary" : "sw-btn-outline")">
                <i class="bi bi-clock-history"></i> On Loan
            </a>
        </div>

        <!-- Sorting -->
        <div class="d-flex align-items-center gap-2">
            <label for="sort" class="sw-form-label mb-0 text-nowrap sw-mono">Sort By</label>
            <select class="sw-input" style="height: 38px; width: auto; min-width: 170px;" id="sort" name="sort" onchange="this.form.submit()" aria-label="Sort books by">
                <option value="title" selected="@((string?)ViewBag.Sort == "title")">Title (A – Z)</option>
                <option value="newest" selected="@((string?)ViewBag.Sort == "newest")">Recently Added</option>
                <option value="popular" selected="@((string?)ViewBag.Sort == "popular")">Most Borrowed</option>
            </select>
        </div>
    </form>
</div>

<!-- Subject Category Chips -->
@if (ViewBag.Categories is List<string> catList && catList.Count > 0)
{
    <div class="sw-filter-chips mb-4">
        <a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-availability="@ViewBag.Availability" asp-route-sort="@ViewBag.Sort"
           class="sw-filter-chip @(string.IsNullOrWhiteSpace((string?)ViewBag.Category) ? "active" : "")">
            All Archive Sections
        </a>
        @foreach (var cat in catList)
        {
            <a asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-category="@cat" asp-route-availability="@ViewBag.Availability" asp-route-sort="@ViewBag.Sort"
               class="sw-filter-chip @((string?)ViewBag.Category == cat ? "active" : "")">
                <i class="bi bi-bookmark me-1 opacity-75"></i> @cat
            </a>
        }
    </div>
}

@if (Model.Count == 0)
{
    <div class="sw-empty-state">
        <div class="sw-empty-icon">
            <i class="bi bi-journal-x"></i>
        </div>
        <h3 class="sw-empty-title">No Matching Volumes in Archive</h3>
        <p class="sw-empty-text">
            No volumes match your current search query or filter combination. Try adjusting your query or resetting filters.
        </p>
        <a class="sw-btn sw-btn-primary" asp-action="Index">
            <i class="bi bi-arrow-counterclockwise"></i> Browse Entire Archive
        </a>
    </div>
}
else
{
    <!-- 1. SIGNATURE WOODEN BOOKSHELF VIEW (Default) -->
    <div id="shelfViewContainer" class="catalogue-view-pane">
        @{
            // Chunk books into realistic shelf rows of 6-8 volumes per row
            var shelfGroups = Model.Select((book, index) => new { book, index })
                                   .GroupBy(x => x.index / 7)
                                   .Select(g => g.Select(x => x.book).ToList())
                                   .ToList();
        }

        <div class="wooden-bookshelf-container">
            @for (int sIdx = 0; sIdx < shelfGroups.Count; sIdx++)
            {
                var shelfBooks = shelfGroups[sIdx];
                var sectionLetter = (char)('A' + (sIdx % 26));
                <div class="wooden-shelf">
                    <!-- Books Row Aligned Bottom -->
                    <div class="shelf-books-row">
                        @foreach (var book in shelfBooks)
                        {
                            var spineColor = GetSpineColor(book.Category, book.Id);
                            var spineHeight = GetSpineHeightClass(book.Id);
                            var spineWidth = GetSpineWidthClass(book.Id);
                            var isAvail = book.AvailableQuantity > 0;
                            var availClass = isAvail ? "spine-status-available" : "spine-status-borrowed";

                            <a asp-action="Details" asp-route-id="@book.Id" 
                               class="book-spine @spineHeight @spineWidth" 
                               data-color="@spineColor"
                               title="@book.Title by @book.Author (@book.AvailableQuantity/@book.TotalQuantity Available)">
                                
                                <!-- Top Filigree & Ribs -->
                                <div class="spine-top-filigree">
                                    <span class="spine-status-dot @availClass"></span>
                                    <div class="spine-gilt-band"></div>
                                    <div class="spine-rib"></div>
                                </div>

                                <!-- Vertical Gold Title & Author -->
                                <div class="spine-title">@book.Title</div>
                                <div class="spine-author">@book.Author</div>

                                <!-- Bottom Ribs & Call Number Brass Tag -->
                                <div class="spine-bottom-filigree">
                                    <div class="spine-rib"></div>
                                    <div class="spine-gilt-band"></div>
                                    <span class="spine-brass-call">#@(book.Id.ToString("D4"))</span>
                                </div>
                            </a>
                        }
                    </div>

                    <!-- 3D Wooden Shelf Ledge with Engraved Center Brass Plaque -->
                    <div class="shelf-ledge">
                        <span class="brass-plate">
                            STACK @sectionLetter &middot; SECTION @(sIdx + 1) &middot; @(shelfBooks.FirstOrDefault()?.Category?.ToUpperInvariant() ?? "FOLIOS")
                        </span>
                    </div>
                    <div class="shelf-ledge-shadow"></div>
                </div>
            }
        </div>
    </div>

    <!-- 2. CARD CATALOG GRID VIEW (Alternative) -->
    <div id="gridViewContainer" class="catalogue-view-pane" style="display: none;">
        <div class="sw-books-grid">
            @foreach (var book in Model)
            {
                <article class="sw-book-card">
                    <div class="sw-book-cover-container">
                        <div class="sw-book-cover-placeholder">
                            <span class="sw-placeholder-spine">#@book.Id.ToString("D4") &middot; @book.Category</span>
                            <div class="sw-placeholder-title">@book.Title</div>
                            <div class="sw-placeholder-author">by @book.Author</div>
                        </div>
                    </div>
                    <div class="sw-book-card-body">
                        <div class="sw-book-meta-top">
                            <span class="brass-tag">@book.Category</span>
                            @if (book.AvailableQuantity > 0)
                            {
                                <span class="sw-badge sw-badge-success">
                                    <span class="sw-badge-dot"></span> @book.AvailableQuantity Available
                                </span>
                            }
                            else
                            {
                                <span class="sw-badge sw-badge-danger">
                                    <span class="sw-badge-dot"></span> On Loan
                                </span>
                            }
                        </div>
                        <h3 class="sw-book-title" title="@book.Title">@book.Title</h3>
                        <p class="sw-book-author">by @book.Author</p>

                        <div class="sw-book-card-actions">
                            <a class="sw-btn sw-btn-outline sw-btn-sm flex-grow-1" asp-action="Details" asp-route-id="@book.Id">
                                Folio Card &rarr;
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                            {
                                @if (book.AvailableQuantity > 0)
                                {
                                    <a class="sw-btn sw-btn-primary sw-btn-sm" asp-controller="AdminCirculation" asp-action="Issue" asp-route-bookId="@book.Id" title="Issue copy">
                                        <i class="bi bi-box-arrow-up-right"></i> Issue
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-5">
            <nav aria-label="Archive pagination">
                <ul class="pagination gap-1">
                    <li class="page-item @((int)ViewBag.Page <= 1 ? "disabled" : "")">
                        <a class="sw-btn sw-btn-outline sw-btn-sm" asp-action="Index"
                           asp-route-page="@((int)ViewBag.Page - 1)"
                           asp-route-q="@ViewBag.Query"
                           asp-route-category="@ViewBag.Category"
                           asp-route-availability="@ViewBag.Availability"
                           asp-route-sort="@ViewBag.Sort">
                            &larr; Prev
                        </a>
                    </li>
                    @for (var p = Math.Max(1, (int)ViewBag.Page - 2); p <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.Page + 2); p++)
                    {
                        <li class="page-item">
                            <a class="sw-btn sw-btn-sm @(p == (int)ViewBag.Page ? "sw-btn-primary" : "sw-btn-outline")" asp-action="Index"
                               asp-route-page="@p"
                               asp-route-q="@ViewBag.Query"
                               asp-route-category="@ViewBag.Category"
                               asp-route-availability="@ViewBag.Availability"
                               asp-route-sort="@ViewBag.Sort">
                                @p
                            </a>
                        </li>
                    }
                    <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                        <a class="sw-btn sw-btn-outline sw-btn-sm" asp-action="Index"
                           asp-route-page="@((int)ViewBag.Page + 1)"
                           asp-route-q="@ViewBag.Query"
                           asp-route-category="@ViewBag.Category"
                           asp-route-availability="@ViewBag.Availability"
                           asp-route-sort="@ViewBag.Sort">
                            Next &rarr;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}

@section Scripts {
    <script>
        function setCatalogueView(mode) {
            const shelfView = document.getElementById('shelfViewContainer');
            const gridView = document.getElementById('gridViewContainer');
            const btnShelf = document.getElementById('btnViewShelf');
            const btnGrid = document.getElementById('btnViewGrid');

            if (mode === 'grid') {
                if (shelfView) shelfView.style.display = 'none';
                if (gridView) gridView.style.display = 'block';
                if (btnShelf) btnShelf.classList.remove('active');
                if (btnGrid) btnGrid.classList.add('active');
                localStorage.setItem('shelfwise-catalogue-view', 'grid');
            } else {
                if (shelfView) shelfView.style.display = 'block';
                if (gridView) gridView.style.display = 'none';
                if (btnShelf) btnShelf.classList.add('active');
                if (btnGrid) btnGrid.classList.remove('active');
                localStorage.setItem('shelfwise-catalogue-view', 'shelf');
            }
        }

        // Restore view preference
        document.addEventListener('DOMContentLoaded', function() {
            const savedView = localStorage.getItem('shelfwise-catalogue-view');
            if (savedView === 'grid') {
                setCatalogueView('grid');
            } else {
                setCatalogueView('shelf');
            }
        });
    </script>
}
