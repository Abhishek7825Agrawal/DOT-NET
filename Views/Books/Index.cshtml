@model IReadOnlyList<Book>
@{ ViewData["Title"] = "Discover Titles"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Explore Collection</div>
        <h1>Library Book Catalogue</h1>
        <p class="text-secondary mb-0 mt-1">Browse available books, verify copy availability, and explore subjects across the library collection.</p>
    </div>
</div>

<form method="get" class="panel mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input class="form-control border-start-0 ps-0" id="q" name="q" value="@ViewBag.Query" placeholder="Search by title, author name, ISBN, or subject..." aria-label="Search catalogue" />
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" id="category" name="category" aria-label="Filter by category">
                <option value="">All Categories</option>
                @if (ViewBag.Categories is List<string> categories)
                {
                    foreach (string category in categories)
                    {
                        <option value="@category" selected="@(category == (string?)ViewBag.Category)">@category</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-search me-1"></i> Search
            </button>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="panel empty-state">
        <i class="bi bi-journal-x"></i>
        <h2 class="h5 mt-3">No matching titles found</h2>
        <p class="mb-3 text-muted">Try using broader search terms or select a different category filter.</p>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Reset Search</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var book in Model)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <article class="book-card d-flex flex-column">
                    <div class="book-cover">
                        <i class="bi bi-book"></i>
                    </div>
                    <div>
                        <span class="badge rounded-pill badge-soft mb-2">@book.Category</span>
                        <h2 class="book-title line-clamp-2">@book.Title</h2>
                        <p class="text-secondary small mb-2">by @book.Author</p>
                    </div>
                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="small fw-semibold @(book.AvailableQuantity > 0 ? "text-success" : "text-danger")">
                            @if (book.AvailableQuantity > 0)
                            {
                                <i class="bi bi-check-circle-fill me-1"></i> @($"{book.AvailableQuantity} available")
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill me-1"></i> @("On loan")
                            }
                        </span>
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@book.Id">
                            Details &rarr;
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav aria-label="Catalogue pagination">
                <ul class="pagination mb-0">
                    <li class="page-item @((int)ViewBag.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category">Previous</a>
                    </li>
                    @for (var p = Math.Max(1, (int)ViewBag.Page - 2); p <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.Page + 2); p++)
                    {
                        <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category">@p</a>
                        </li>
                    }
                    <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}
