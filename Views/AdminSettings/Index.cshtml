@model LibrarySettingsViewModel
@{
    ViewData["Title"] = "Library Rules & Settings";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker"><span class="sw-kicker-dot"></span> System Governance</div>
        <h1 class="sw-title-display">Library Rules &amp; Policy Settings</h1>
        <p class="sw-page-subtitle">Configure loan periods, overdue fine calculations, member borrowing limits, and operational timezone.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="sw-table-card p-4 p-md-5 sw-fade-in-up">
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="sw-alert sw-alert-danger mb-4"></div>

                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--sw-border) !important;">
                        <i class="bi bi-clock-history fs-5 text-primary"></i>
                        <h2 class="h6 text-uppercase fw-bold mb-0" style="letter-spacing: 0.08em; font-family: var(--sw-font-mono);">
                            Loan Durations &amp; Overdue Penalties
                        </h2>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="LoanPeriodDays" class="sw-form-label"></label>
                            <div class="input-group">
                                <input asp-for="LoanPeriodDays" class="form-control sw-input" type="number" min="1" max="365" required />
                                <span class="input-group-text bg-transparent" style="border-color: var(--sw-input-border);">days</span>
                            </div>
                            <span asp-validation-for="LoanPeriodDays" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted mt-1">Standard lending duration before a loan is flagged overdue.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GracePeriodDays" class="sw-form-label"></label>
                            <div class="input-group">
                                <input asp-for="GracePeriodDays" class="form-control sw-input" type="number" min="0" max="30" required />
                                <span class="input-group-text bg-transparent" style="border-color: var(--sw-input-border);">days</span>
                            </div>
                            <span asp-validation-for="GracePeriodDays" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted mt-1">Days allowed past due date before daily fines begin accruing.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FineRatePerDay" class="sw-form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent" style="border-color: var(--sw-input-border);">₹</span>
                                <input asp-for="FineRatePerDay" class="form-control sw-input" type="number" min="0" max="10000" step="0.5" required />
                                <span class="input-group-text bg-transparent" style="border-color: var(--sw-input-border);">/ day</span>
                            </div>
                            <span asp-validation-for="FineRatePerDay" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted mt-1">Daily fine amount levied per overdue volume.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LostBookPenaltyFee" class="sw-form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent" style="border-color: var(--sw-input-border);">₹</span>
                                <input asp-for="LostBookPenaltyFee" class="form-control sw-input" type="number" min="0" max="50000" step="10" required />
                            </div>
                            <span asp-validation-for="LostBookPenaltyFee" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted mt-1">Fixed penalty fee charged when a book is declared lost.</div>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--sw-border) !important;">
                        <i class="bi bi-person-badge fs-5 text-primary"></i>
                        <h2 class="h6 text-uppercase fw-bold mb-0" style="letter-spacing: 0.08em; font-family: var(--sw-font-mono);">
                            Borrower Quotas &amp; Localization
                        </h2>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="MaxBooksPerMember" class="sw-form-label"></label>
                            <div class="input-group">
                                <input asp-for="MaxBooksPerMember" class="form-control sw-input" type="number" min="1" max="50" required />
                                <span class="input-group-text bg-transparent" style="border-color: var(--sw-input-border);">books</span>
                            </div>
                            <span asp-validation-for="MaxBooksPerMember" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted mt-1">Maximum concurrent active loans permitted per cardholder.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TimeZoneId" class="sw-form-label"></label>
                            <input asp-for="TimeZoneId" class="form-control sw-input" placeholder="e.g. Asia/Kolkata or UTC" required />
                            <span asp-validation-for="TimeZoneId" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted mt-1">Operational timezone for midnight calendar and due date calculation.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 pt-3 border-top" style="border-color: var(--sw-border) !important;">
                    <button class="sw-btn sw-btn-primary sw-btn-lg" type="submit">
                        <i class="bi bi-check-lg me-1"></i> Save Configuration Rules
                    </button>
                    <a class="sw-btn sw-btn-outline sw-btn-lg" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
