@model PasswordManagementViewModel
@{
    ViewData["Title"] = "Password Management";
}
<section class="sw-page-header"><span class="sw-kicker">Secure account recovery</span><h1 class="sw-h2">Password Management</h1><p class="text-muted">Reset actions send single-use Identity links. Passwords and hashes are never shown here.</p></section>
<section class="parchment-card p-3 p-lg-4">
    <form method="get" class="d-flex gap-2 mb-3"><label for="q" class="visually-hidden">Filter reset history</label><input id="q" name="q" value="@Model.Query" class="sw-form-control" placeholder="Filter by account or event" /><button class="sw-btn sw-btn-primary">Filter</button><a asp-controller="AdminUsers" asp-action="Index" class="sw-btn sw-btn-secondary">User Management</a></form>
    <div class="table-responsive"><table class="table sw-table align-middle"><thead><tr><th>Timestamp</th><th>Account</th><th>Action</th><th>Result</th><th>Event</th></tr></thead><tbody>
    @foreach (var item in Model.Items) { <tr><td>@item.LocalTimestamp.ToString("yyyy-MM-dd HH:mm")</td><td>@item.UserEmail</td><td>@item.Description</td><td>@item.Outcome</td><td><code>@item.EventType</code></td></tr> }
    @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No password recovery events.</td></tr> }
    </tbody></table></div>
    @if (Model.TotalPages > 1) { <nav aria-label="Password history pages" class="d-flex justify-content-between"><span>Page @Model.Page of @Model.TotalPages</span><div class="d-flex gap-2"><a class="sw-btn sw-btn-sm sw-btn-secondary" asp-route-page="@(Model.Page - 1)" asp-route-q="@Model.Query">Previous</a><a class="sw-btn sw-btn-sm sw-btn-secondary" asp-route-page="@(Model.Page + 1)" asp-route-q="@Model.Query">Next</a></div></nav> }
</section>
