@model SalesLedgerViewModel
@{
    ViewData["Title"] = "Author Sales Ledger & Revenue Accounting";
}

<div class="sw-editorial-container pb-5">
    <!-- Header Section -->
    <section class="sw-page-header py-4 py-md-5 border-bottom mb-4" style="border-color: var(--sw-border) !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="sw-kicker sw-kicker-navy">Financial Accounting &amp; Royalty Distributions</span>
                <h1 class="sw-h1 display-5 mb-2" style="font-family: var(--sw-font-serif); font-weight: 700; color: var(--sw-navy);">
                    Author Sales Ledger<span class="text-primary">.</span>
                </h1>
                <p class="text-muted mb-0 fs-6">
                    Transparent, itemized statement of manuscript acquisitions, platform commissions, and net earnings.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="AuthorDesk" class="sw-btn sw-btn-outline">
                    <i class="bi bi-arrow-left me-1"></i> Back to Author Desk
                </a>
            </div>
        </div>
    </section>

    <!-- Financial KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="sw-kpi-card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Gross Sales</span>
                    <div class="sw-kpi-icon sw-icon-navy"><i class="bi bi-cart-check"></i></div>
                </div>
                <div class="sw-kpi-value font-monospace">₹@Model.TotalGross.ToString("F2")</div>
                <span class="text-muted small">Total paid transactions volume</span>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="sw-kpi-card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Platform Fee</span>
                    <div class="sw-kpi-icon sw-icon-crimson"><i class="bi bi-pie-chart-fill"></i></div>
                </div>
                <div class="sw-kpi-value text-muted font-monospace">₹@Model.TotalCommission.ToString("F2")</div>
                <span class="text-muted small">Retained platform commission</span>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="sw-kpi-card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Net Earnings</span>
                    <div class="sw-kpi-icon sw-icon-teal"><i class="bi bi-wallet2"></i></div>
                </div>
                <div class="sw-kpi-value text-success font-monospace">₹@Model.TotalNet.ToString("F2")</div>
                <span class="text-muted small">Direct net payout credited</span>
            </div>
        </div>
    </div>

    <!-- Ledger Table Card -->
    <div class="sw-table-card p-0 overflow-hidden mb-4">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--sw-border) !important;">
            <h2 class="h6 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Itemized Transaction Log</h2>
            <span class="badge bg-light text-muted border">@Model.Transactions.Count records</span>
        </div>

        @if (!Model.Transactions.Any())
        {
            <div class="text-center py-5 px-4">
                <div class="sw-kpi-icon sw-icon-navy mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.8rem;">
                    <i class="bi bi-receipt"></i>
                </div>
                <h3 class="h5 fw-bold mb-1" style="font-family: var(--sw-font-serif);">No Completed Transactions Yet</h3>
                <p class="text-muted small mb-0">When members acquire your paid research papers, detailed fee breakdowns will appear in this ledger.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                        <tr>
                            <th class="ps-4">Order Ref</th>
                            <th>Manuscript Title</th>
                            <th>Date (UTC)</th>
                            <th>Gross Amount</th>
                            <th>Commission</th>
                            <th>Net Earnings</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model.Transactions)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <code class="fw-bold font-monospace text-primary">@tx.OrderNumber</code>
                                </td>
                                <td>
                                    <a asp-controller="Marketplace" asp-action="Details" asp-route-id="@tx.PaperId" class="text-decoration-none fw-bold text-navy" style="font-family: var(--sw-font-serif);">
                                        @tx.PaperTitle
                                    </a>
                                </td>
                                <td class="text-muted small">
                                    @tx.OrderDateUtc.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td class="font-monospace">
                                    ₹@tx.GrossAmount.ToString("F2")
                                </td>
                                <td class="font-monospace text-muted small">
                                    ₹@tx.CommissionAmount.ToString("F2") <span class="badge bg-light text-muted border ms-1">@tx.CommissionRate.ToString("0.##")%</span>
                                </td>
                                <td class="font-monospace fw-bold text-success">
                                    ₹@tx.NetEarnings.ToString("F2")
                                </td>
                                <td class="text-end pe-4">
                                    <span class="sw-badge sw-badge-success font-monospace">Settled</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold font-monospace">
                        <tr>
                            <td colspan="3" class="ps-4">Total Portfolio Ledger</td>
                            <td>₹@Model.TotalGross.ToString("F2")</td>
                            <td class="text-muted">₹@Model.TotalCommission.ToString("F2")</td>
                            <td class="text-success">₹@Model.TotalNet.ToString("F2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
