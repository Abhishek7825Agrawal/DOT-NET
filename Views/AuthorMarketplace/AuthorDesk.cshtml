@model AuthorDeskViewModel
@{
    ViewData["Title"] = "Author Research Desk";
}

<div class="sw-editorial-container pb-5">
    <!-- Header Section -->
    <section class="sw-page-header py-4 py-md-5 border-bottom mb-4" style="border-color: var(--sw-border) !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="sw-kicker sw-kicker-navy">Scholarly Author Portal</span>
                <h1 class="sw-h1 display-5 mb-2" style="font-family: var(--sw-font-serif); font-weight: 700; color: var(--sw-navy);">
                    Author Research Desk<span class="text-primary">.</span>
                </h1>
                <p class="text-muted mb-0 fs-6">
                    Manage your submitted manuscripts, track editorial peer-review status, and inspect publication analytics.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="SalesLedger" class="sw-btn sw-btn-outline">
                    <i class="bi bi-receipt me-1"></i> Sales Ledger
                </a>
                <a asp-action="Submit" class="sw-btn sw-btn-primary">
                    <i class="bi bi-file-earmark-plus me-1"></i> Submit New Manuscript
                </a>
            </div>
        </div>
    </section>

    @if (TempData["Success"] is string successMsg)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 4 KPI Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="sw-kpi-card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Manuscripts</span>
                    <div class="sw-kpi-icon sw-icon-navy"><i class="bi bi-journal-text"></i></div>
                </div>
                <div class="sw-kpi-value">@Model.Metrics.TotalSubmissions</div>
                <span class="text-muted small">Total submissions</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="sw-kpi-card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Published</span>
                    <div class="sw-kpi-icon sw-icon-teal"><i class="bi bi-patch-check-fill"></i></div>
                </div>
                <div class="sw-kpi-value text-success">@Model.Metrics.ApprovedCount</div>
                <span class="text-muted small">Peer-reviewed &amp; live</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="sw-kpi-card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Acquisitions</span>
                    <div class="sw-kpi-icon sw-icon-gold"><i class="bi bi-bag-check-fill"></i></div>
                </div>
                <div class="sw-kpi-value">@Model.Metrics.TotalSalesCount</div>
                <span class="text-muted small">Total orders / acquisitions</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="sw-kpi-card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.05em;">Net Earnings</span>
                    <div class="sw-kpi-icon sw-icon-crimson"><i class="bi bi-cash-stack"></i></div>
                </div>
                <div class="sw-kpi-value text-primary font-monospace">₹@Model.Metrics.NetEarnings.ToString("F2")</div>
                <span class="text-muted small">Gross ₹@Model.Metrics.GrossRevenue.ToString("F2") less platform fee</span>
            </div>
        </div>
    </div>

    <!-- Submissions Table Card -->
    <div class="sw-table-card p-0 overflow-hidden mb-4">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--sw-border) !important;">
            <h2 class="h6 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">My Research Submissions</h2>
            <span class="badge bg-light text-muted border">@Model.MyPapers.Count entries</span>
        </div>

        @if (!Model.MyPapers.Any())
        {
            <div class="text-center py-5 px-4">
                <div class="sw-kpi-icon sw-icon-navy mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.8rem;">
                    <i class="bi bi-file-earmark-arrow-up"></i>
                </div>
                <h3 class="h5 fw-bold mb-1" style="font-family: var(--sw-font-serif);">No Manuscripts Submitted Yet</h3>
                <p class="text-muted small mb-3">Publish your academic paper, working study, or thesis to the research exchange.</p>
                <a asp-action="Submit" class="sw-btn sw-btn-primary sw-btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Submit First Manuscript
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                        <tr>
                            <th class="ps-4">Title &amp; Meta</th>
                            <th>Domain</th>
                            <th>Tier / Price</th>
                            <th>Version</th>
                            <th>Review Status</th>
                            <th>Submitted</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var paper in Model.MyPapers)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-navy" style="font-family: var(--sw-font-serif); font-size: 1rem;">
                                        @paper.Title
                                    </div>
                                    <small class="text-muted"><i class="bi bi-people me-1"></i>@paper.Authors &bull; @paper.PageCount pages</small>
                                </td>
                                <td>
                                    <span class="sw-badge sw-badge-neutral">@paper.Category</span>
                                </td>
                                <td>
                                    @if (paper.IsPaid && paper.Price > 0m)
                                    {
                                        <span class="font-monospace fw-bold text-primary">₹@paper.Price.ToString("F2")</span>
                                    }
                                    else
                                    {
                                        <span class="sw-badge sw-badge-success font-monospace">Open Access</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">v@paper.CurrentVersion</span>
                                </td>
                                <td>
                                    @switch (paper.Status)
                                    {
                                        case PaperStatus.Approved:
                                            <span class="sw-badge sw-badge-success"><i class="bi bi-check-circle me-1"></i>Published</span>
                                            break;
                                        case PaperStatus.PendingReview:
                                            <span class="sw-badge sw-badge-warning"><i class="bi bi-hourglass-split me-1"></i>Pending Review</span>
                                            break;
                                        case PaperStatus.CorrectionRequested:
                                            <span class="sw-badge sw-badge-accent"><i class="bi bi-pencil-square me-1"></i>Revisions Requested</span>
                                            break;
                                        case PaperStatus.Rejected:
                                            <span class="sw-badge sw-badge-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                            break;
                                        case PaperStatus.Suspended:
                                            <span class="badge bg-dark text-white"><i class="bi bi-slash-circle me-1"></i>Suspended</span>
                                            break;
                                        default:
                                            <span class="sw-badge sw-badge-neutral">@paper.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted small">
                                    @paper.SubmittedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        @if (paper.Status == PaperStatus.Approved)
                                        {
                                            <a asp-controller="Marketplace" asp-action="Details" asp-route-id="@paper.Id" class="sw-btn sw-btn-outline sw-btn-sm" title="View Public Listing">
                                                <i class="bi bi-eye me-1"></i> View
                                            </a>
                                            <a asp-controller="Marketplace" asp-action="Stream" asp-route-id="@paper.Id" target="_blank" class="sw-btn sw-btn-primary sw-btn-sm" title="Read manuscript PDF">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> Read
                                            </a>
                                        }
                                        else if (paper.Status == PaperStatus.CorrectionRequested || paper.Status == PaperStatus.Draft)
                                        {
                                            <a asp-action="Edit" asp-route-id="@paper.Id" class="sw-btn sw-btn-primary sw-btn-sm" title="Submit revised manuscript">
                                                <i class="bi bi-pencil-square me-1"></i> Revise &amp; Resubmit
                                            </a>
                                        }
                                        else if (paper.Status == PaperStatus.Rejected)
                                        {
                                            <button type="button" class="sw-btn sw-btn-outline sw-btn-sm text-danger border-danger" data-bs-toggle="modal" data-bs-target="#reasonModal-@paper.Id">
                                                <i class="bi bi-info-circle me-1"></i> Feedback
                                            </button>

                                            <!-- Modal for feedback -->
                                            <div class="modal fade" id="reasonModal-@paper.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" style="font-family: var(--sw-font-serif);">Editorial Feedback</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <p class="text-muted small mb-2">The editorial review board provided the following comments:</p>
                                                            <div class="p-3 bg-light rounded border text-danger small font-monospace">
                                                                @(string.IsNullOrEmpty(paper.RejectionReason) ? "No detailed feedback specified." : paper.RejectionReason)
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="sw-btn sw-btn-outline sw-btn-sm" data-bs-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <a asp-controller="Marketplace" asp-action="Stream" asp-route-id="@paper.Id" target="_blank" class="sw-btn sw-btn-outline sw-btn-sm" title="Inspect submitted PDF">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> Preview PDF
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
