@model AdminProfileViewModel
@{ ViewData["Title"] = "Admin Profile"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Account Security</div>
        <h1>Administrator Profile</h1>
        <p class="text-secondary mb-0 mt-1">Manage system administrator credentials and security settings.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="panel">
            <h2 class="panel-title mb-3">Administrator Information</h2>
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" readonly />
                    <div class="form-text">System administrator primary email account.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label">Username / Display Handle</label>
                    <input asp-for="DisplayName" class="form-control" readonly />
                </div>

                <div class="mb-4">
                    <label asp-for="PhoneNumber" class="form-label">Contact Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="+91 98765 43210" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-save me-1"></i> Update Contact Info
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="panel h-100">
            <h2 class="panel-title mb-3">Security & Password</h2>
            <p class="text-secondary small mb-4">Protect the library system console by maintaining strong, non-reusable passwords.</p>

            <div class="p-3 border rounded bg-light mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                    <strong>Role Authorization</strong>
                </div>
                <div class="small text-secondary">
                    Your account holds elevated <code>Admin</code> privileges with unrestricted access to circulation, financials, member statuses, and catalog management.
                </div>
            </div>

            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="ChangePassword">
                <i class="bi bi-key me-1"></i> Change Console Password
            </a>
        </div>
    </div>
</div>

