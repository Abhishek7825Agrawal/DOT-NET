@model AdminProfileViewModel
@{
    ViewData["Title"] = "Staff & Admin Profile";
    var roleName = User.IsInRole("Admin") ? "Administrator" : "Library Staff";
}

<div class="sw-page-header sw-fade-in-up">
    <div class="sw-page-title-group">
        <span class="sw-kicker">Operator Credentials</span>
        <h1 class="sw-h2 mb-1">@roleName Profile</h1>
        <p class="text-muted small mb-0">Manage console identity, desk phone coordinates, and authentication credentials.</p>
    </div>
</div>

<div class="row g-4 sw-fade-in-up">
    <div class="col-lg-6">
        <div class="sw-table-card p-4">
            <span class="sw-kicker">Operator Details</span>
            <h3 class="sw-h3 mb-3">Console Identity</h3>

            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="sw-alert sw-alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="sw-form-label">Email Address</label>
                    <input asp-for="Email" class="sw-form-control" readonly />
                    <div class="sw-mono text-muted" style="font-size:0.7rem;margin-top:0.3rem">System administrative login identifier.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayName" class="sw-form-label">Username / Display Handle</label>
                    <input asp-for="DisplayName" class="sw-form-control" readonly />
                </div>

                <div class="mb-4">
                    <label asp-for="PhoneNumber" class="sw-form-label">Desk Contact Phone</label>
                    <input asp-for="PhoneNumber" class="sw-form-control" placeholder="+91 ..." />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <button class="sw-btn sw-btn-primary" type="submit">
                    <i class="bi bi-save"></i> Update Contact Info
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="sw-table-card p-4 h-100">
            <span class="sw-kicker">Access Level</span>
            <h3 class="sw-h3 mb-3">Role Authorization</h3>
            <p class="text-muted small mb-4">Protect the library system console by using strong credentials.</p>

            <div class="p-3 border rounded bg-light mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                    <strong>@roleName Clearance</strong>
                </div>
                <div class="small text-muted">
                    Your account holds active operational rights for circulation desks, book inventory, and borrower assistance.
                </div>
            </div>

            <a class="sw-btn sw-btn-outline" asp-controller="Account" asp-action="ChangePassword">
                <i class="bi bi-key"></i> Change Password
            </a>
        </div>
    </div>
</div>
