@model ProfileViewModel
@{
    ViewData["Title"] = "Borrower Cardholder Profile";
}

<div class="sw-page-header sw-fade-in-up">
    <div class="sw-page-title-group">
        <span class="sw-kicker">Reader Profile</span>
        <h1 class="sw-h2 mb-1">My Library Card</h1>
        <p class="text-muted small mb-0">Review contact coordinates, residential details, and borrowing privileges.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Back to Reading Room
        </a>
    </div>
</div>

<div class="row g-4 sw-fade-in-up" style="max-width:1080px">
    <div class="col-lg-7">
        <div class="sw-table-card p-4">
            <span class="sw-kicker">Contact Dossier</span>
            <h3 class="sw-h3 mb-3">Cardholder Details</h3>

            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="sw-alert sw-alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="sw-form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="sw-form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="sw-form-label">Email Address</label>
                    <input asp-for="Email" class="sw-form-control" readonly />
                    <div class="sw-mono text-muted" style="font-size:0.7rem;margin-top:0.3rem">
                        Primary identifier for lending notices. Contact circulation desk to alter email.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="sw-form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="sw-form-control" placeholder="+91 98765 43210" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="sw-form-label">Residential / Postal Address</label>
                    <textarea asp-for="Address" class="sw-form-control" rows="3" placeholder="Department / Residence address..."></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-2">
                    <span class="sw-mono small text-muted">
                        <i class="bi bi-calendar3 me-1"></i> Member since @Model.RegisteredAtUtc.ToString("dd MMMM yyyy")
                    </span>
                    <button class="sw-btn sw-btn-primary" type="submit">
                        <i class="bi bi-check2"></i> Save Profile
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="d-flex flex-column gap-4">
            <div class="sw-table-card p-4">
                <span class="sw-kicker">Card Standing</span>
                <h3 class="sw-h3 mb-3">Borrowing Status</h3>

                <div class="p-3 bg-light rounded border mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <strong class="small">Good Standing</strong>
                    </div>
                    <p class="small text-muted mb-0">Your cardholder status is active with borrowing privileges across all collection subjects.</p>
                </div>

                <div class="p-3 bg-light rounded border mb-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-shield-check text-primary fs-5"></i>
                        <strong class="small">Security &amp; Credentials</strong>
                    </div>
                    <p class="small text-muted mb-0">Maintain password confidentiality to protect your borrowing records.</p>
                </div>

                <a class="sw-btn sw-btn-outline w-100" asp-controller="Account" asp-action="ChangePassword">
                    <i class="bi bi-key"></i> Change Password
                </a>
            </div>
        </div>
    </div>
</div>
