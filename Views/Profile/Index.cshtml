@model ProfileViewModel
@{ ViewData["Title"] = "Borrower Profile"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Personal Account</div>
        <h1>My Borrower Profile</h1>
        <p class="text-secondary mb-0 mt-1">Review contact information, registered address, and security credentials.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<div class="row g-4" style="max-width:960px">
    <div class="col-md-7">
        <div class="panel">
            <h2 class="panel-title mb-3">Contact Information</h2>
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" readonly />
                    <div class="form-text">Primary identifier for notifications and login. Contact library administrator to change email.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Mobile Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="+91 98765 43210" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label">Postal / Residential Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Department / Hostel / Residential address..."></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="small text-secondary">
                        <i class="bi bi-calendar3 me-1"></i> Member since @Model.RegisteredAtUtc.ToString("dd MMMM yyyy")
                    </span>
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-check2 me-1"></i> Save Profile
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="panel h-100">
            <h2 class="panel-title mb-3">Security & Account Status</h2>
            <div class="p-3 bg-light rounded border mb-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <strong>Good Standing</strong>
                </div>
                <small class="text-secondary">Your borrower account has active circulation rights and can borrow titles from the collection.</small>
            </div>

            <div class="p-3 bg-light rounded border mb-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-key-fill text-primary fs-5"></i>
                    <strong>Password Security</strong>
                </div>
                <small class="text-secondary">Keep your password confidential to safeguard your loan records.</small>
            </div>

            <a class="btn btn-outline-primary w-100" asp-controller="Account" asp-action="ChangePassword">
                <i class="bi bi-lock me-1"></i> Change Password
            </a>
        </div>
    </div>
</div>
