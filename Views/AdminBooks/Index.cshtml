@model IReadOnlyList<Book>
@{ ViewData["Title"] = "Book Collection"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Inventory Management</div>
        <h1>Book Collection</h1>
        <p class="text-secondary mb-0 mt-1">Manage catalogued titles, monitor available inventory, and archive retired books.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> Add Title
        </a>
    </div>
</div>

<form method="get" class="panel mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input class="form-control border-start-0 ps-0" name="q" value="@ViewBag.Query" placeholder="Search title, author, ISBN or publisher..." aria-label="Search books" />
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" name="category" aria-label="Filter by category">
                <option value="">All Categories</option>
                @if (ViewBag.Categories is List<string> categoryList)
                {
                    foreach (var cat in categoryList)
                    {
                        <option value="@cat" selected="@(cat == (string?)ViewBag.Category)">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-secondary" type="submit">Filter</button>
        </div>
    </div>
</form>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-book"></i>
            <h3 class="h6 mt-3">No titles found</h3>
            <p class="mb-0 text-muted">Try adjusting your search criteria or add a new title to the collection.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Title & Author</th>
                        <th>ISBN</th>
                        <th>Category</th>
                        <th>Copies</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@book.Title</div>
                                <small class="text-secondary">by @book.Author</small>
                            </td>
                            <td><code>@(book.Isbn ?? "—")</code></td>
                            <td><span class="badge rounded-pill badge-soft">@book.Category</span></td>
                            <td>
                                <span class="fw-bold @(book.AvailableQuantity > 0 ? "text-success" : "text-danger")">@book.AvailableQuantity</span>
                                <span class="text-secondary">/ @book.TotalQuantity</span>
                            </td>
                            <td>
                                @if (book.IsActive)
                                {
                                    <span class="badge rounded-pill text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Archived</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Edit" asp-route-id="@book.Id">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>

                                @if (book.IsActive)
                                {
                                    <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline" data-confirm="Archive this title? Existing loan records will be preserved safely.">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">
                                            <i class="bi bi-archive me-1"></i> Archive
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Restore" asp-route-id="@book.Id" method="post" class="d-inline" data-confirm="Restore this archived title back to the active catalogue?">
                                        <button class="btn btn-sm btn-outline-success" type="submit">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-secondary">Page @ViewBag.Page of @ViewBag.TotalPages</span>
        <nav aria-label="Book pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @((int)ViewBag.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category">Previous</a>
                </li>
                @for (var p = Math.Max(1, (int)ViewBag.Page - 2); p <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.Page + 2); p++)
                {
                    <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category">@p</a>
                    </li>
                }
                <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query" asp-route-category="@ViewBag.Category">Next</a>
                </li>
            </ul>
        </nav>
    </div>
}
