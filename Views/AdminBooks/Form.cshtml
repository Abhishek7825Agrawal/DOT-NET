@model BookFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add Book Title" : "Edit Book Title"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Collection Management</div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-secondary mb-0 mt-1">Configure metadata, cataloguing category, and available copies.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i> Back to Collection
    </a>
</div>

<div class="panel" style="max-width:880px">
    <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" novalidate>
        <input asp-for="Id" type="hidden" />
        <input asp-for="RowVersion" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label">Book Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Clean Code: A Handbook of Agile Software Craftsmanship" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Author" class="form-label">Author <span class="text-danger">*</span></label>
                <input asp-for="Author" class="form-control" placeholder="e.g. Robert C. Martin" required />
                <span asp-validation-for="Author" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Isbn" class="form-label">ISBN-10 or ISBN-13</label>
                <input asp-for="Isbn" class="form-control" placeholder="e.g. 9780132350884" />
                <span asp-validation-for="Isbn" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Category" class="form-label">Category / Genre <span class="text-danger">*</span></label>
                <input asp-for="Category" class="form-control" list="categorySuggestions" placeholder="Select or enter category" required />
                <datalist id="categorySuggestions">
                    @if (ViewBag.CategoryOptions is List<SelectListItem> options)
                    {
                        foreach (var opt in options)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    }
                </datalist>
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Publisher" class="form-label">Publisher</label>
                <input asp-for="Publisher" class="form-control" placeholder="e.g. Prentice Hall" />
            </div>
            <div class="col-md-4">
                <label asp-for="PublicationYear" class="form-label">Publication Year</label>
                <input asp-for="PublicationYear" class="form-control" type="number" min="1450" max="2100" placeholder="e.g. 2008" />
                <span asp-validation-for="PublicationYear" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TotalQuantity" class="form-label">Total Copies in Inventory <span class="text-danger">*</span></label>
                <input asp-for="TotalQuantity" class="form-control" type="number" min="0" max="10000" required />
                <span asp-validation-for="TotalQuantity" class="text-danger small"></span>
            </div>
            @if (Model.Id != 0)
            {
                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check mt-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Active in Public Catalogue</label>
                    </div>
                </div>
            }
            <div class="col-12">
                <label asp-for="Description" class="form-label">Synopsis / Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Brief summary, edition details, or library remarks..."></textarea>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4 pt-2 border-top">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check-lg me-1"></i> Save Title
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
