@model IssueBookViewModel
@{ ViewData["Title"] = "Issue a Book"; }

<div class="page-heading">
    <div>
        <div class="eyebrow">Borrowing Desk</div>
        <h1>Issue a Book</h1>
        <p class="text-secondary mb-0 mt-1">Select an active member and an available catalogue title to create a new loan record.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i> Back to Circulation Desk
    </a>
</div>

<div class="panel" style="max-width:760px">
    <form asp-action="Issue" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="mb-4">
            <label asp-for="MemberId" class="form-label">Select Borrower / Member <span class="text-danger">*</span></label>
            <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select form-select-lg" required>
                <option value="0">-- Choose registered active member --</option>
            </select>
            <span asp-validation-for="MemberId" class="text-danger small"></span>
            <div class="form-text">Only active members without excessive overdue holds are eligible to borrow.</div>
        </div>

        <div class="mb-4">
            <label asp-for="BookId" class="form-label">Select Book Title <span class="text-danger">*</span></label>
            <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select form-select-lg" required>
                <option value="0">-- Choose book with available inventory copies --</option>
            </select>
            <span asp-validation-for="BookId" class="text-danger small"></span>
            <div class="form-text">Available stock decreases by 1 immediately upon issue.</div>
        </div>

        <div class="p-3 rounded bg-light border mb-4 small text-secondary">
            <i class="bi bi-info-circle text-primary me-1"></i>
            Due date will automatically be set according to the configured standard loan period (default 14 days). Duplicate active loans of the same title to the same borrower are rejected by system policy.
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-lg px-4" type="submit">
                <i class="bi bi-check2-circle me-1"></i> Confirm & Issue Loan
            </button>
            <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
