@model IReadOnlyList<IssueRecord>
@inject LibraryCalendar LibraryCalendar
@{
    ViewData["Title"] = (bool)ViewBag.Overdue ? "Overdue Archive Loans" : "Circulation Desk Register";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker sw-kicker-forest"><i class="bi bi-arrow-left-right me-1"></i> CIRCULATION OPERATIONS</div>
        <h1 class="sw-h1">@ViewData["Title"]</h1>
        <p class="sw-body text-muted mb-0">Track active loans, process returns with rubber-stamp verification, and collect fines.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-action="Payments">
            <i class="bi bi-receipt me-1"></i> Payment Ledger
        </a>
        <a class="sw-btn sw-btn-brass" asp-action="Issue">
            <i class="bi bi-plus-lg me-1"></i> Issue Volume
        </a>
    </div>
</div>

<!-- Search & Status Filter Panel -->
<form method="get" class="parchment-card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-lg-5 col-md-12">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 border-warning border-opacity-50"><i class="bi bi-search text-muted"></i></span>
                <input class="form-control border-start-0 ps-0 sw-input" name="q" value="@ViewBag.Query" placeholder="Search borrower card, email, book title or ISBN..." aria-label="Search circulation" />
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <select class="form-select sw-input" name="status" aria-label="Filter by loan status">
                <option value="">All Loan Statuses</option>
                <option value="0" selected="@(ViewBag.Status is IssueStatus s && s == IssueStatus.Active)">Active Loans Only</option>
                <option value="1" selected="@(ViewBag.Status is IssueStatus s1 && s1 == IssueStatus.Returned)">Returned Only</option>
                <option value="2" selected="@(ViewBag.Status is IssueStatus s2 && s2 == IssueStatus.Lost)">Lost Volumes Only</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-3">
            <div class="form-check pt-1 ms-2">
                <input class="form-check-input" type="checkbox" name="overdue" value="true" id="overdueCheck" checked="@((bool)ViewBag.Overdue)" />
                <label class="form-check-label fw-semibold small" for="overdueCheck">Overdue only</label>
            </div>
        </div>
        <div class="col-lg-2 col-md-3 d-grid">
            <button class="sw-btn sw-btn-primary" type="submit">Filter Register</button>
        </div>
    </div>
</form>

<!-- Circulation Table Card -->
<div class="sw-table-card">
    @if (Model.Count == 0)
    {
        <div class="sw-empty-state py-5">
            <div class="sw-empty-icon"><i class="bi bi-arrow-left-right"></i></div>
            <h3 class="sw-empty-title">No circulation records found</h3>
            <p class="sw-empty-text">No lending entries match the selected filter criteria.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="sw-table mb-0">
                <thead>
                    <tr>
                        <th>Book Volume</th>
                        <th>Borrower Card</th>
                        <th>Issued Date</th>
                        <th>Due Date</th>
                        <th>Fines &amp; Dues</th>
                        <th>Archive Status</th>
                        <th class="text-end">Desk Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var issue in Model)
                {
                    var today = (DateTime)ViewBag.Today;
                    var isOverdue = issue.Status == IssueStatus.Active && issue.DueDateUtc.Date < today;
                    var accruedFine = FineCalculator.CalculateAccruedFine(issue, today);
                    var outstandingBalance = FineCalculator.CalculateOutstandingBalance(issue, today);

                    <tr class="@(isOverdue ? "table-warning" : "")">
                        <td>
                            <div class="fw-bold" style="color: var(--sw-walnut-deep);">@issue.Book.Title</div>
                            <small class="text-muted sw-mono">ISBN: @(issue.Book.Isbn ?? "—")</small>
                            @if (!string.IsNullOrWhiteSpace(issue.Remarks))
                            {
                                <div class="small text-muted fst-italic mt-1"><i class="bi bi-info-circle me-1"></i>@issue.Remarks</div>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold">@issue.Member.FullName</div>
                            <small class="text-muted sw-mono">@issue.Member.User.Email</small>
                        </td>
                        <td class="sw-mono text-nowrap">@issue.IssueDateUtc.ToString("dd MMM yyyy")</td>
                        <td class="text-nowrap">
                            <span class="@(isOverdue ? "text-danger fw-bold" : "sw-mono")">
                                @issue.DueDateUtc.ToString("dd MMM yyyy")
                                @if (isOverdue)
                                {
                                    <div class="stamp-box stamp-overdue mt-1" style="font-size:0.65rem; padding:0.15rem 0.45rem;">
                                        @((today - issue.DueDateUtc.Date).Days) DAYS LATE
                                    </div>
                                }
                            </span>
                        </td>
                        <td>
                            <div>
                                <span class="fw-bold @(outstandingBalance > 0 ? "text-danger" : "text-muted") sw-mono">
                                    @accruedFine.ToString("C")
                                </span>
                                @if (issue.Status != IssueStatus.Active && issue.FinePaidAmount > 0)
                                {
                                    <small class="text-success d-block sw-mono">Paid: @issue.FinePaidAmount.ToString("C")</small>
                                }
                                @if (outstandingBalance > 0)
                                {
                                    <small class="text-danger fw-semibold d-block sw-mono">Due: @outstandingBalance.ToString("C")</small>
                                }
                            </div>
                            @if (issue.FinePayments.Count > 0)
                            {
                                <details class="small mt-1 text-muted">
                                    <summary class="cursor-pointer">Payments (@issue.FinePayments.Count)</summary>
                                    <div class="p-2 border rounded mt-1 bg-surface" style="font-size:.78rem; border-color: var(--sw-border-warm) !important;">
                                        @foreach (var p in issue.FinePayments.OrderByDescending(x => x.PaymentDateUtc))
                                        {
                                            <div>
                                                <strong>@p.Amount.ToString("C")</strong> via @p.PaymentMethod on @LibraryCalendar.ToLocal(p.PaymentDateUtc).ToString("dd MMM yyyy")
                                                @(string.IsNullOrWhiteSpace(p.ReferenceNumber) ? "" : $" (Ref: {p.ReferenceNumber})")
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </td>
                        <td>
                            @if (isOverdue)
                            {
                                <span class="sw-badge sw-badge-danger"><span class="sw-badge-dot"></span> Overdue</span>
                            }
                            else if (issue.Status == IssueStatus.Active)
                            {
                                <span class="sw-badge sw-badge-info"><span class="sw-badge-dot"></span> Active Loan</span>
                            }
                            else if (issue.Status == IssueStatus.Returned)
                            {
                                <div class="stamp-box stamp-returned stamped-returned-animated" style="font-size:0.7rem; padding:0.2rem 0.5rem;">
                                    STAMPED RETURNED
                                </div>
                            }
                            else if (issue.Status == IssueStatus.Lost)
                            {
                                <span class="sw-badge sw-badge-neutral" style="background-color: var(--sw-walnut-deep); color: var(--sw-gold-muted);"><span class="sw-badge-dot"></span> Declared Lost</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (issue.Status == IssueStatus.Active)
                            {
                                <div class="d-flex gap-1 justify-content-end">
                                    <!-- Return Form with Animated Rubber Stamp Trigger -->
                                    <form asp-action="Return" asp-route-id="@issue.Id" method="post" class="d-inline" data-confirm="Confirm return and apply RETURNED stamp to '@issue.Book.Title'?">
                                        <button class="sw-btn sw-btn-sm sw-btn-brass" type="submit" title="Stamp Return">
                                            <i class="bi bi-box-arrow-in-down me-1"></i> Stamp Return
                                        </button>
                                    </form>

                                    <!-- Mark Lost Form -->
                                    <form asp-action="MarkLost" asp-route-id="@issue.Id" method="post" class="d-inline" data-confirm="Declare this title as LOST by the borrower? Total book inventory will be adjusted and penalty recorded.">
                                        <button class="sw-btn sw-btn-sm sw-btn-outline text-danger" type="submit" title="Mark as Lost">
                                            <i class="bi bi-x-octagon me-1"></i> Lost
                                        </button>
                                    </form>
                                </div>
                            }
                            else if (outstandingBalance > 0)
                            {
                                <!-- Record Fine Payment Form -->
                                <button class="sw-btn sw-btn-sm sw-btn-forest" type="button" data-bs-toggle="collapse" data-bs-target="#payForm_@issue.Id" aria-expanded="false" aria-controls="payForm_@issue.Id">
                                    <i class="bi bi-cash me-1"></i> Collect Fine
                                </button>
                                <div class="collapse mt-2 text-start" id="payForm_@issue.Id">
                                    <form asp-action="PayFine" asp-route-id="@issue.Id" method="post" class="p-3 border rounded shadow-sm" style="min-width:260px; background-color: var(--sw-surface); border-color: var(--sw-border-warm) !important;">
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold mb-1" for="amt_@issue.Id">Amount (₹)</label>
                                            <input id="amt_@issue.Id" name="Amount" type="number" min="0.01" max="@outstandingBalance" step="0.01" value="@outstandingBalance" class="form-control form-control-sm sw-input" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold mb-1" for="method_@issue.Id">Payment Method</label>
                                            <select id="method_@issue.Id" name="PaymentMethod" class="form-select form-select-sm sw-input">
                                                <option value="0">Cash</option>
                                                <option value="1">Bank Transfer (UPI / IMPS)</option>
                                                <option value="2">Card</option>
                                                <option value="3">Other</option>
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold mb-1" for="ref_@issue.Id">Receipt / Ref No.</label>
                                            <input id="ref_@issue.Id" name="ReferenceNumber" maxlength="120" placeholder="Optional Receipt / UPI ID" class="form-control form-control-sm sw-input" />
                                        </div>
                                        <button class="sw-btn sw-btn-primary sw-btn-sm w-100" type="submit">Submit Payment</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-success small fw-semibold"><i class="bi bi-check2-all me-1"></i>Settled</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4">
        <span class="small text-muted sw-mono">Folio @ViewBag.Page of @ViewBag.TotalPages</span>
        <nav aria-label="Circulation pagination">
            <div class="d-flex gap-1">
                @if ((int)ViewBag.Page > 1)
                {
                    <a class="sw-btn sw-btn-outline sw-btn-sm" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query" asp-route-overdue="@ViewBag.Overdue" asp-route-status="@ViewBag.Status">&larr; Prev</a>
                }
                @for (var p = Math.Max(1, (int)ViewBag.Page - 2); p <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.Page + 2); p++)
                {
                    <a class="sw-btn sw-btn-sm @(p == (int)ViewBag.Page ? "sw-btn-primary" : "sw-btn-outline")" asp-action="Index" asp-route-page="@p" asp-route-q="@ViewBag.Query" asp-route-overdue="@ViewBag.Overdue" asp-route-status="@ViewBag.Status">@p</a>
                }
                @if ((int)ViewBag.Page < (int)ViewBag.TotalPages)
                {
                    <a class="sw-btn sw-btn-outline sw-btn-sm" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query" asp-route-overdue="@ViewBag.Overdue" asp-route-status="@ViewBag.Status">Next &rarr;</a>
                }
            </div>
        </nav>
    </div>
}
