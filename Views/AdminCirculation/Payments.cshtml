@model IReadOnlyList<FinePayment>
@inject LibraryCalendar LibraryCalendar
@{
    ViewData["Title"] = "Fine Payment Ledger";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker"><span class="sw-kicker-dot"></span> Financial Audit</div>
        <h1 class="sw-title-display">Fine Payment Ledger</h1>
        <p class="sw-page-subtitle">Historical audit trail of all collected penalties, settlement transactions, and payment receipts.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-controller="AdminReports" asp-action="ExportPayments">
            <i class="bi bi-download me-1"></i> Export to CSV
        </a>
        <a class="sw-btn sw-btn-outline" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i> Return to Desk
        </a>
    </div>
</div>

<form method="get" class="sw-table-card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--sw-input-border);"><i class="bi bi-search text-muted"></i></span>
                <input class="form-control border-start-0 ps-0 sw-input" name="q" value="@ViewBag.Query" placeholder="Search by borrower name, email, book title or receipt reference..." aria-label="Search payment history" />
            </div>
        </div>
        <div class="col-auto">
            <button class="sw-btn sw-btn-outline" type="submit">Filter Ledger</button>
        </div>
    </div>
</form>

<div class="sw-table-card">
    @if (Model.Count == 0)
    {
        <div class="sw-empty-state py-5">
            <div class="sw-empty-icon"><i class="bi bi-receipt"></i></div>
            <h3 class="sw-empty-title">No payment records found</h3>
            <p class="sw-empty-text">No fine settlement receipts match the filter query.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="sw-table mb-0">
                <thead>
                    <tr>
                        <th>Receipt ID</th>
                        <th>Borrower</th>
                        <th>Book Title</th>
                        <th>Amount Paid</th>
                        <th>Method</th>
                        <th>Reference / Notes</th>
                        <th>Recorded Date &amp; Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-semibold" style="color: var(--sw-navy);">#FP-@payment.Id.ToString("D5")</td>
                            <td>
                                <div class="fw-semibold">@payment.IssueRecord.Member.FullName</div>
                                <small class="text-muted font-monospace">@payment.IssueRecord.Member.User.Email</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width:240px">@payment.IssueRecord.Book.Title</div>
                                <small class="text-muted font-monospace">Loan #@payment.IssueRecordId</small>
                            </td>
                            <td>
                                <span class="fw-bold text-success font-monospace fs-6">@payment.Amount.ToString("C")</span>
                            </td>
                            <td>
                                <span class="sw-badge sw-badge-neutral">@payment.PaymentMethod</span>
                            </td>
                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(payment.ReferenceNumber) ? "—" : payment.ReferenceNumber)
                            </td>
                            <td class="font-monospace small text-nowrap">
                                @LibraryCalendar.ToLocal(payment.PaymentDateUtc).ToString("dd MMM yyyy, hh:mm tt")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
