@model IReadOnlyList<Member>
@{
    ViewData["Title"] = "Member Directory";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker"><span class="sw-kicker-dot"></span> User Directory</div>
        <h1 class="sw-title-display">Member Accounts</h1>
        <p class="sw-page-subtitle">Review registered cardholders, inspect borrowing history, and administer membership privileges.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-primary" asp-action="RegisterCustomer">
            <i class="bi bi-person-plus me-1"></i> Register Member
        </a>
        <a class="sw-btn sw-btn-accent" asp-action="BulkImport">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Excel Bulk Import
        </a>
        <a class="sw-btn sw-btn-outline" asp-action="ImportHistory">
            <i class="bi bi-clock-history me-1"></i> Batch History
        </a>
    </div>
</div>

<form method="get" class="sw-table-card p-3 mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0" style="border-color: var(--sw-input-border);"><i class="bi bi-search text-muted"></i></span>
                <input class="form-control border-start-0 ps-0 sw-input" name="q" value="@ViewBag.Query" placeholder="Search by member name, email address, or phone number..." aria-label="Search members" />
            </div>
        </div>
        <div class="col-auto">
            <button class="sw-btn sw-btn-outline" type="submit">Search Members</button>
        </div>
    </div>
</form>

<div class="sw-table-card">
    @if (Model.Count == 0)
    {
        <div class="sw-empty-state py-5">
            <div class="sw-empty-icon"><i class="bi bi-people"></i></div>
            <h3 class="sw-empty-title">No members found</h3>
            <p class="sw-empty-text">No member accounts match the current query.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="sw-table mb-0">
                <thead>
                    <tr>
                        <th>Member Details</th>
                        <th>Contact</th>
                        <th>Address</th>
                        <th>Registered</th>
                        <th>Status</th>
                        <th class="text-end">Account Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>
                                <div>
                                    <a asp-action="Details" asp-route-id="@member.Id" class="fw-bold text-decoration-none" style="color: var(--sw-navy);">
                                        @member.FullName
                                    </a>
                                </div>
                                <small class="text-muted font-monospace">@member.User.Email</small>
                            </td>
                            <td>@(member.PhoneNumber ?? "—")</td>
                            <td><small class="text-muted">@(member.Address ?? "—")</small></td>
                            <td class="font-monospace text-nowrap">@member.RegisteredAtUtc.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (member.IsActive)
                                {
                                    <span class="sw-badge sw-badge-success"><span class="sw-badge-dot"></span> Active</span>
                                }
                                else
                                {
                                    <span class="sw-badge sw-badge-neutral"><span class="sw-badge-dot"></span> Suspended</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@member.Id" class="sw-btn sw-btn-sm sw-btn-outline me-1" title="View Member Profile & Loans">
                                    <i class="bi bi-person-vcard me-1"></i> Dossier
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="SetStatus" method="post" class="d-inline" data-confirm="@(member.IsActive ? "Deactivate this member? Their borrowing privileges will be suspended immediately." : "Reactivate this member's borrowing account?")">
                                        <input type="hidden" name="id" value="@member.Id" />
                                        <input type="hidden" name="active" value="@(!member.IsActive)" />
                                        <button class="sw-btn sw-btn-sm sw-btn-outline @(member.IsActive ? "text-danger" : "text-success")" type="submit">
                                            <i class="bi @(member.IsActive ? "bi-person-x" : "bi-person-check") me-1"></i>
                                            @(member.IsActive ? "Suspend" : "Activate")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4">
        <span class="small text-muted font-monospace">Page @ViewBag.Page of @ViewBag.TotalPages</span>
        <nav aria-label="Member list pagination">
            <div class="d-flex gap-1">
                @if ((int)ViewBag.Page > 1)
                {
                    <a class="sw-btn sw-btn-outline sw-btn-sm" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query">&larr; Prev</a>
                }
                @for (var p = Math.Max(1, (int)ViewBag.Page - 2); p <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.Page + 2); p++)
                {
                    <a class="sw-btn sw-btn-sm @(p == (int)ViewBag.Page ? "sw-btn-primary" : "sw-btn-outline")" asp-action="Index" asp-route-page="@p" asp-route-q="@ViewBag.Query">@p</a>
                }
                @if ((int)ViewBag.Page < (int)ViewBag.TotalPages)
                {
                    <a class="sw-btn sw-btn-outline sw-btn-sm" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query">Next &rarr;</a>
                }
            </div>
        </nav>
    </div>
}
