@model ExcelUploadViewModel
@{
    ViewData["Title"] = "Excel Member Bulk Import";
}

<div class="sw-page-header">
    <div class="sw-page-title-group">
        <div class="sw-kicker"><span class="sw-kicker-dot"></span> Staff Operations &bull; Bulk Onboarding</div>
        <h1 class="sw-title-display">Excel Member Bulk Import</h1>
        <p class="sw-page-subtitle">Batch enroll cardholders using standardized Excel spreadsheets with automatic format validation, duplicate detection, and staged preview.</p>
    </div>
    <div class="sw-page-actions">
        <a class="sw-btn sw-btn-outline" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i> Member Directory
        </a>
        <a class="sw-btn sw-btn-outline" asp-action="RegisterCustomer">
            <i class="bi bi-person-plus me-1"></i> Individual Registration
        </a>
        <a class="sw-btn sw-btn-outline" asp-action="ImportHistory">
            <i class="bi bi-clock-history me-1"></i> Import History
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <!-- Left Column: Guidelines & Template Download -->
    <div class="col-lg-5">
        <div class="sw-table-card p-4 h-100">
            <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom" style="border-color: var(--sw-border) !important;">
                <div class="sw-kpi-icon sw-icon-navy" style="width: 44px; height: 44px; font-size: 1.3rem;">
                    <i class="bi bi-journal-arrow-down"></i>
                </div>
                <div>
                    <h3 class="h5 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Import Guidelines</h3>
                    <small class="text-muted">Follow these standards for seamless onboarding.</small>
                </div>
            </div>

            <ol class="list-unstyled mb-4" style="line-height: 1.8;">
                <li class="mb-3 d-flex align-items-start gap-2">
                    <span class="badge rounded-circle p-1" style="background-color: var(--sw-navy); color: #fff; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">1</span>
                    <div>
                        <strong class="d-block" style="color: var(--sw-navy);">Download the Official Template</strong>
                        <span class="small text-muted">Use the pre-formatted <code>.xlsx</code> workbook containing column headers, data formats, and sample rows.</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start gap-2">
                    <span class="badge rounded-circle p-1" style="background-color: var(--sw-navy); color: #fff; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">2</span>
                    <div>
                        <strong class="d-block" style="color: var(--sw-navy);">Enter Cardholder Data</strong>
                        <span class="small text-muted"><code>Full Name</code> (required) and <code>Email Address</code> (required). <code>Phone Number</code> and <code>Address</code> are optional.</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start gap-2">
                    <span class="badge rounded-circle p-1" style="background-color: var(--sw-navy); color: #fff; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">3</span>
                    <div>
                        <strong class="d-block" style="color: var(--sw-navy);">Upload &amp; Review Matrix</strong>
                        <span class="small text-muted">The system audits each row, detecting malformed entries and duplicates in real-time. No database records are written until you explicitly confirm.</span>
                    </div>
                </li>
                <li class="d-flex align-items-start gap-2">
                    <span class="badge rounded-circle p-1" style="background-color: var(--sw-navy); color: #fff; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">4</span>
                    <div>
                        <strong class="d-block" style="color: var(--sw-navy);">Confirm Staged Import</strong>
                        <span class="small text-muted">Valid records are committed atomically. Download an error audit report for any rejected or duplicate entries.</span>
                    </div>
                </li>
            </ol>

            <div class="pt-3 border-top" style="border-color: var(--sw-border) !important;">
                <a asp-action="DownloadTemplate" class="sw-btn sw-btn-accent w-100 py-3 text-center d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-file-earmark-excel fs-5"></i>
                    <span>Download Excel Registration Template (.xlsx)</span>
                </a>
                <small class="text-muted d-block text-center mt-2">Includes Instructions &amp; Members tabs · ~10 KB</small>
            </div>
        </div>
    </div>

    <!-- Right Column: Upload Box -->
    <div class="col-lg-7">
        <div class="sw-table-card p-4 p-md-5 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom" style="border-color: var(--sw-border) !important;">
                    <div class="sw-kpi-icon sw-icon-terracotta" style="width: 44px; height: 44px; font-size: 1.3rem;">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                    </div>
                    <div>
                        <h3 class="h5 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Upload Spreadsheet</h3>
                        <small class="text-muted">Select an Excel workbook (.xlsx) up to 5 MB.</small>
                    </div>
                </div>

                <form asp-action="UploadExcel" method="post" enctype="multipart/form-data" novalidate id="uploadForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-4 rounded-0" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="ExcelFile" class="form-label fw-semibold small text-uppercase" style="letter-spacing: 0.05em; color: var(--sw-navy);">
                            Select Excel Spreadsheet (.xlsx) <span class="text-danger">*</span>
                        </label>
                        <div class="p-4 text-center border border-2 border-dashed rounded-0" style="background-color: var(--sw-paper-warm, #fdfbf7); border-color: var(--sw-border) !important;">
                            <i class="bi bi-file-earmark-spreadsheet display-4 text-muted mb-2 d-block"></i>
                            <input asp-for="ExcelFile" type="file" accept=".xlsx" class="form-control sw-input mb-2" id="excelFileInput" />
                            <small class="text-muted d-block">Supported formats: Microsoft Excel OpenXML Spreadsheet (.xlsx) &bull; Maximum file size: 5 MB</small>
                        </div>
                        <span asp-validation-for="ExcelFile" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Security Alert -->
                    <div class="p-3 mb-4 rounded-0 border-start border-4" style="background-color: rgba(22, 37, 33, 0.04); border-color: var(--sw-navy) !important;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-shield-check text-muted mt-1"></i>
                            <div class="small text-muted">
                                <strong class="text-dark">Safe Staging Verification:</strong> Uploading will not modify database accounts immediately. All rows will be parsed into a preview matrix so you can inspect valid, invalid, and duplicate records prior to final confirmation.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-3 border-top" style="border-color: var(--sw-border) !important;">
                        <a asp-action="Index" class="sw-btn sw-btn-outline">
                            Cancel
                        </a>
                        <button type="submit" class="sw-btn sw-btn-primary" id="uploadSubmitBtn">
                            <i class="bi bi-arrow-right-circle me-1"></i> Upload &amp; Preview Matrix
                        </button>
                    </div>
                </form>
            </div>

            <div class="pt-4 mt-4 border-top" style="border-color: var(--sw-border) !important;">
                <div class="d-flex align-items-center justify-content-between text-muted small">
                    <span><i class="bi bi-shield-lock me-1"></i> Cryptographic random credentials</span>
                    <span><i class="bi bi-file-earmark-check me-1"></i> ClosedXML engine</span>
                    <span><i class="bi bi-database-check me-1"></i> Transactional commit</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
