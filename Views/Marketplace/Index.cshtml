@model MarketplaceCatalogViewModel
@{
    ViewData["Title"] = "Research Paper Marketplace";
}

<div class="sw-editorial-container pb-5">

    <!-- Header Section -->
    <section class="sw-page-header py-4 py-md-5 border-bottom mb-4" style="border-color: var(--sw-border) !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="sw-kicker sw-kicker-navy">Academic Repository &amp; Research Exchange</span>
                <h1 class="sw-h1 display-5 mb-2" style="font-family: var(--sw-font-serif); font-weight: 700; color: var(--sw-navy);">
                    Research Paper Marketplace<span class="text-primary">.</span>
                </h1>
                <p class="text-muted mb-0 fs-6" style="max-width: 680px;">
                    Peer-reviewed manuscripts, working papers, and scholarly dissertations. Discover open-access findings or acquire specialized research directly from verified scholars.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-action="MyPurchases" class="sw-btn sw-btn-outline">
                        <i class="bi bi-journal-check me-1"></i> My Acquired Papers
                    </a>
                    <a asp-controller="AuthorMarketplace" asp-action="AuthorDesk" class="sw-btn sw-btn-primary">
                        <i class="bi bi-pencil-square me-1"></i> Author Desk
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="sw-btn sw-btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Publish
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Search & Filter Controls -->
    <div class="sw-table-card p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-muted small text-uppercase" style="letter-spacing: 0.05em;">Search Manuscripts</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-color: var(--sw-border);"><i class="bi bi-search text-muted"></i></span>
                    <input type="search" name="q" value="@Model.Query" class="form-control sw-input border-start-0" placeholder="Title, abstract, author, or keywords..." />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small text-uppercase" style="letter-spacing: 0.05em;">Subject Domain</label>
                <select name="category" class="form-select sw-input">
                    <option value="">All Academic Domains</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat" selected="@(Model.Category == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small text-uppercase" style="letter-spacing: 0.05em;">Access Tier</label>
                <select name="priceFilter" class="form-select sw-input">
                    <option value="all" selected="@(Model.PriceFilter == "all" ? "selected" : null)">All Listings</option>
                    <option value="free" selected="@(Model.PriceFilter == "free" ? "selected" : null)">Open Access (Free)</option>
                    <option value="paid" selected="@(Model.PriceFilter == "paid" ? "selected" : null)">Premium Manuscripts</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="sw-btn sw-btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.Query) || !string.IsNullOrEmpty(Model.Category) || Model.PriceFilter != "all")
                {
                    <a asp-action="Index" class="sw-btn sw-btn-outline" title="Clear Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Results Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 text-muted small">
        <div>
            Showing <strong class="text-dark">@Model.Papers.Count</strong> of <strong class="text-dark">@Model.TotalCount</strong> manuscripts
            @if (!string.IsNullOrEmpty(Model.Query))
            {
                <span>for "<em>@Model.Query</em>"</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <span>Sort:</span>
            <a asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-priceFilter="@Model.PriceFilter" asp-route-sort="newest" class="text-decoration-none @(Model.Sort == "newest" ? "fw-bold text-primary" : "text-muted")">Newest</a> &bull;
            <a asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-priceFilter="@Model.PriceFilter" asp-route-sort="popular" class="text-decoration-none @(Model.Sort == "popular" ? "fw-bold text-primary" : "text-muted")">Most Read</a> &bull;
            <a asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-priceFilter="@Model.PriceFilter" asp-route-sort="price-asc" class="text-decoration-none @(Model.Sort == "price-asc" ? "fw-bold text-primary" : "text-muted")">Price: Low to High</a>
        </div>
    </div>

    <!-- Paper Cards Grid -->
    @if (Model.Papers.Count == 0)
    {
        <div class="text-center py-5 sw-table-card">
            <div class="mb-3 text-muted" style="font-size: 3rem;"><i class="bi bi-file-earmark-text"></i></div>
            <h3 class="h5 fw-bold" style="font-family: var(--sw-font-serif);">No research manuscripts match your criteria</h3>
            <p class="text-muted small">Try adjusting your keywords, subject domain filter, or price tier.</p>
            <a asp-action="Index" class="sw-btn sw-btn-outline sw-btn-sm">Reset Catalog Filters</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var paper in Model.Papers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="sw-table-card p-4 h-100 d-flex flex-column justify-content-between position-relative" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                        <div>
                            <!-- Domain Badge & Access Tier -->
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="sw-badge sw-badge-neutral">@paper.Category</span>
                                @if (paper.IsPaid && paper.Price > 0m)
                                {
                                    <span class="sw-badge sw-badge-accent fw-bold font-monospace">₹@paper.Price.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="sw-badge sw-badge-success font-monospace">OPEN ACCESS</span>
                                }
                            </div>

                            <!-- Title -->
                            <h2 class="h5 mb-2" style="font-family: var(--sw-font-serif); font-weight: 700; line-height: 1.3;">
                                <a asp-action="Details" asp-route-id="@paper.Id" class="text-decoration-none" style="color: var(--sw-navy);">
                                    @paper.Title
                                </a>
                            </h2>

                            <!-- Author & Institution -->
                            <div class="small text-muted mb-3">
                                <div><i class="bi bi-person me-1"></i>@paper.Authors</div>
                                <div class="text-truncate"><i class="bi bi-building me-1"></i>@paper.Affiliation</div>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="pt-3 border-top mt-3" style="border-color: var(--sw-border) !important;">
                            <div class="d-flex align-items-center justify-content-between text-muted small mb-3">
                                <span><i class="bi bi-calendar3 me-1"></i>@paper.PublicationYear</span>
                                <span><i class="bi bi-file-text me-1"></i>@paper.PageCount pages</span>
                                <span><i class="bi bi-download me-1"></i>@(paper.DownloadCount + paper.PurchaseCount)</span>
                            </div>

                            <a asp-action="Details" asp-route-id="@paper.Id" class="sw-btn sw-btn-outline w-100 text-center">
                                View Manuscript <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-5">
                <nav aria-label="Marketplace Catalogue Pages">
                    <ul class="pagination pagination-sm m-0">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-q="@Model.Query" asp-route-category="@Model.Category" asp-route-priceFilter="@Model.PriceFilter" asp-route-sort="@Model.Sort">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>
