@model PaperDetailsViewModel
@{
    ViewData["Title"] = Model.Paper.Title;
}

<div class="sw-editorial-container pb-5">

    <!-- Breadcrumb -->
    <nav class="pt-3 pb-2" aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Research Marketplace</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-category="@Model.Paper.Category" class="text-decoration-none">@Model.Paper.Category</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 320px;">@Model.Paper.Title</li>
        </ol>
    </nav>

    <!-- Top Academic Header -->
    <section class="py-4 border-bottom mb-4" style="border-color: var(--sw-border) !important;">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="sw-badge sw-badge-neutral">@Model.Paper.Category</span>
            @if (Model.Paper.IsPaid && Model.Paper.Price > 0m)
            {
                <span class="sw-badge sw-badge-accent fw-bold font-monospace">₹@Model.Paper.Price.ToString("F2")</span>
            }
            else
            {
                <span class="sw-badge sw-badge-success font-monospace">OPEN ACCESS</span>
            }
            <span class="sw-badge sw-badge-info"><i class="bi bi-shield-check me-1"></i>Copyright Verified</span>
            @if (Model.Paper.CurrentVersion > 1)
            {
                <span class="sw-badge sw-badge-warning">Version @Model.Paper.CurrentVersion</span>
            }
        </div>

        <h1 class="display-6 mb-3" style="font-family: var(--sw-font-serif); font-weight: 700; color: var(--sw-navy); line-height: 1.25;">
            @Model.Paper.Title
        </h1>

        <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
            <div><i class="bi bi-people me-1"></i><strong>@Model.Paper.Authors</strong></div>
            <div>&bull;</div>
            <div><i class="bi bi-building me-1"></i>@Model.Paper.Affiliation</div>
            <div>&bull;</div>
            <div><i class="bi bi-calendar3 me-1"></i>Published: @Model.Paper.PublicationYear</div>
            @if (!string.IsNullOrEmpty(Model.Paper.Doi))
            {
                <div>&bull;</div>
                <div><span class="font-monospace">DOI: @Model.Paper.Doi</span></div>
            }
        </div>
    </section>

    <div class="row g-4">
        <!-- Main Content: Abstract & Metadata -->
        <div class="col-lg-8">
            <!-- Academic Abstract -->
            <div class="sw-table-card p-4 p-md-5 mb-4">
                <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom" style="border-color: var(--sw-border) !important;">
                    <div class="sw-kpi-icon sw-icon-navy" style="width: 40px; height: 40px; font-size: 1.2rem;">
                        <i class="bi bi-card-text"></i>
                    </div>
                    <div>
                        <h2 class="h5 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Abstract</h2>
                        <small class="text-muted">Executive summary of scholarly research findings.</small>
                    </div>
                </div>

                <div class="sw-abstract-body" style="font-family: var(--sw-font-serif); font-size: 1.05rem; line-height: 1.8; color: #2d3748; white-space: pre-line;">
                    @Model.Paper.Abstract
                </div>

                <!-- Keywords -->
                <div class="pt-4 mt-4 border-top" style="border-color: var(--sw-border) !important;">
                    <span class="text-muted small text-uppercase d-block mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Indexed Keywords</span>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var kw in Model.Paper.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="sw-badge sw-badge-neutral"><i class="bi bi-tag me-1"></i>@kw</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Immutable Version History -->
            <div class="sw-table-card p-4 p-md-5 mb-4">
                <div class="d-flex align-items-center gap-3 pb-3 mb-3 border-bottom" style="border-color: var(--sw-border) !important;">
                    <div class="sw-kpi-icon sw-icon-navy" style="width: 40px; height: 40px; font-size: 1.2rem;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h2 class="h5 mb-0 fw-bold" style="font-family: var(--sw-font-serif);">Manuscript Revision History</h2>
                        <small class="text-muted">Immutable log of published editions and peer review revisions.</small>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead>
                            <tr class="text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <th>Revision</th>
                                <th>Date (UTC)</th>
                                <th>Length</th>
                                <th>Size</th>
                                <th>Summary / Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.VersionHistory)
                            {
                                <tr>
                                    <td>
                                        <span class="sw-badge @(v.VersionNumber == Model.Paper.CurrentVersion ? "sw-badge-success" : "sw-badge-neutral")">
                                            v@(v.VersionNumber) @(v.VersionNumber == Model.Paper.CurrentVersion ? "(Current)" : "")
                                        </span>
                                    </td>
                                    <td class="font-monospace text-muted">@v.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>@v.PageCount pages</td>
                                    <td class="font-monospace">@((v.FileSizeBytes / 1024.0).ToString("N0")) KB</td>
                                    <td class="text-muted">@(v.ChangeSummary ?? "Standard revision")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Action Sidebar -->
        <div class="col-lg-4">
            <!-- Acquisition / Read Action Box -->
            <div class="sw-table-card p-4 mb-4">
                <span class="sw-kicker sw-kicker-navy mb-2">Access &amp; Acquisition</span>

                @if (Model.CanAccess)
                {
                    <div class="alert alert-success border-0 bg-success bg-opacity-10 mb-4 p-3 rounded-0">
                        <div class="d-flex align-items-center gap-2 text-success fw-bold mb-1">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span>Access Rights Verified</span>
                        </div>
                        <p class="small text-muted mb-0">
                            @if (Model.IsAuthor)
                            {
                                <span>You are the registered author of this manuscript. Full privileges are active.</span>
                            }
                            else if (Model.IsOwned)
                            {
                                <span>You hold a permanent cardholder license for this manuscript.</span>
                            }
                            else
                            {
                                <span>This manuscript is published under Open Access distribution.</span>
                            }
                        </p>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <a asp-action="Stream" asp-route-id="@Model.Paper.Id" target="_blank" class="sw-btn sw-btn-primary w-100 text-center">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Read Online (PDF Stream)
                        </a>
                        <a asp-action="Download" asp-route-id="@Model.Paper.Id" class="sw-btn sw-btn-outline w-100 text-center">
                            <i class="bi bi-download me-1"></i> Download PDF (@((Model.Paper.FileSizeBytes / 1024.0).ToString("N0")) KB)
                        </a>
                    </div>
                }
                else
                {
                    <!-- Pricing & Purchase Flow -->
                    <div class="p-3 mb-4 rounded-0" style="background-color: var(--sw-paper-warm, #fdfbf7); border: 1px solid var(--sw-border);">
                        <span class="text-muted small text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.05em;">Manuscript Fee</span>
                        @if (Model.Paper.IsPaid && Model.Paper.Price > 0m)
                        {
                            <div class="display-6 fw-bold font-monospace" style="color: var(--sw-navy);">
                                ₹@Model.Paper.Price.ToString("F2")
                            </div>
                            <small class="text-muted d-block mt-1">Single-user perpetual scholarly research license.</small>
                        }
                        else
                        {
                            <div class="h3 fw-bold text-success font-monospace mb-1">FREE</div>
                            <small class="text-muted d-block">Open Access scholarly paper.</small>
                        }
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (Model.CanPurchase)
                        {
                            if (!Model.Paper.IsPaid || Model.Paper.Price <= 0m)
                            {
                                <form asp-action="AcquireFree" method="post">
                                    <input type="hidden" name="paperId" value="@Model.Paper.Id" />
                                    <button type="submit" class="sw-btn sw-btn-success w-100 py-3 text-center">
                                        <i class="bi bi-journal-plus me-1"></i> Acquire Free Access
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-action="Checkout" asp-route-id="@Model.Paper.Id" class="sw-btn sw-btn-primary w-100 py-3 text-center">
                                    <i class="bi bi-bag-check me-1"></i> Order Manuscript (₹@Model.Paper.Price.ToString("F2"))
                                </a>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning small p-3 rounded-0 mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i> @Model.PurchaseBlockedReason
                            </div>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="sw-btn sw-btn-primary w-100 text-center">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Acquire
                        </a>
                    }
                }
            </div>

            <!-- Author & Submitter Details -->
            <div class="sw-table-card p-4 mb-4">
                <span class="sw-kicker sw-kicker-navy mb-2">Author &amp; Attribution</span>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="sw-kpi-icon sw-icon-navy" style="width: 44px; height: 44px; font-size: 1.3rem;">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">@Model.Paper.Authors</div>
                        <small class="text-muted">@Model.Paper.Affiliation</small>
                    </div>
                </div>

                <dl class="row small mb-0" style="line-height: 1.8;">
                    <dt class="col-6 text-muted">Pages</dt>
                    <dd class="col-6 text-end fw-bold">@Model.Paper.PageCount</dd>

                    <dt class="col-6 text-muted">File Size</dt>
                    <dd class="col-6 text-end font-monospace">@((Model.Paper.FileSizeBytes / (1024.0 * 1024.0)).ToString("F2")) MB</dd>

                    <dt class="col-6 text-muted">Checksum</dt>
                    <dd class="col-6 text-end font-monospace text-truncate" title="@Model.Paper.ChecksumSha256">
                        @Model.Paper.ChecksumSha256[..10]...
                    </dd>
                </dl>
            </div>

            <!-- Copyright Notice & Report Link -->
            <div class="sw-table-card p-4">
                <div class="d-flex align-items-start gap-2 small text-muted mb-3">
                    <i class="bi bi-shield-check text-success fs-5"></i>
                    <div>
                        <strong>Academic Warranty</strong>
                        <p class="mb-0 mt-1" style="font-size: 0.8rem;">The author has declared copyright ownership and non-infringement on @Model.Paper.CopyrightAcceptedAtUtc.ToString("dd MMM yyyy").</p>
                    </div>
                </div>

                <div class="pt-2 border-top text-center" style="border-color: var(--sw-border) !important;">
                    <a asp-action="ReportCopyright" asp-route-id="@Model.Paper.Id" class="text-danger small text-decoration-none">
                        <i class="bi bi-flag me-1"></i> Report Copyright Infringement (DMCA)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
