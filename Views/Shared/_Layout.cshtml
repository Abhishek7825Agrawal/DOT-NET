@using Microsoft.AspNetCore.Identity
@using LibraryManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Shelfwise Library</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
{
    <!-- Admin SaaS Shell with Professional Sidebar -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-header">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-book-half"></i></span>
                    <span class="brand-wordmark">Shelfwise<span class="brand-period">.</span><small>LIBRARY DESK</small></span>
                </a>
            </div>
            <nav class="sidebar-nav">
                <p class="nav-section-title">Overview</p>
                <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" aria-current="@(currentController == "Dashboard" ? "page" : null)">
                    <i class="bi bi-grid-1x2"></i> <span>Dashboard</span>
                </a>
                <a class="sidebar-link @(currentController == "AdminReports" ? "active" : "")" asp-controller="AdminReports" asp-action="Index" aria-current="@(currentController == "AdminReports" ? "page" : null)">
                    <i class="bi bi-bar-chart-line"></i> <span>Reports & Analytics</span>
                </a>

                <p class="nav-section-title">Collection</p>
                <a class="sidebar-link @(currentController == "AdminBooks" ? "active" : "")" asp-controller="AdminBooks" asp-action="Index" aria-current="@(currentController == "AdminBooks" ? "page" : null)">
                    <i class="bi bi-journal-bookmark"></i> <span>Books Catalogue</span>
                </a>
                <a class="sidebar-link @(currentController == "AdminCategories" ? "active" : "")" asp-controller="AdminCategories" asp-action="Index" aria-current="@(currentController == "AdminCategories" ? "page" : null)">
                    <i class="bi bi-tags"></i> <span>Categories</span>
                </a>

                <p class="nav-section-title">Borrowing Desk</p>
                <a class="sidebar-link @(currentController == "AdminCirculation" && currentAction == "Issue" ? "active" : "")" asp-controller="AdminCirculation" asp-action="Issue" aria-current="@(currentAction == "Issue" ? "page" : null)">
                    <i class="bi bi-plus-circle"></i> <span>Issue a Book</span>
                </a>
                <a class="sidebar-link @(currentController == "AdminCirculation" && currentAction == "Index" ? "active" : "")" asp-controller="AdminCirculation" asp-action="Index" aria-current="@(currentAction == "Index" ? "page" : null)">
                    <i class="bi bi-arrow-left-right"></i> <span>All Circulation</span>
                </a>
                <a class="sidebar-link @(currentAction == "Overdue" ? "active" : "")" asp-controller="AdminCirculation" asp-action="Overdue" aria-current="@(currentAction == "Overdue" ? "page" : null)">
                    <i class="bi bi-clock-history"></i> <span>Overdue Loans</span>
                </a>
                <a class="sidebar-link @(currentAction == "Payments" ? "active" : "")" asp-controller="AdminCirculation" asp-action="Payments" aria-current="@(currentAction == "Payments" ? "page" : null)">
                    <i class="bi bi-cash-stack"></i> <span>Fine Payments</span>
                </a>

                <p class="nav-section-title">Administration</p>
                <a class="sidebar-link @(currentController == "AdminMembers" ? "active" : "")" asp-controller="AdminMembers" asp-action="Index" aria-current="@(currentController == "AdminMembers" ? "page" : null)">
                    <i class="bi bi-people"></i> <span>Member Accounts</span>
                </a>
                <a class="sidebar-link @(currentController == "AdminSettings" ? "active" : "")" asp-controller="AdminSettings" asp-action="Index" aria-current="@(currentController == "AdminSettings" ? "page" : null)">
                    <i class="bi bi-sliders"></i> <span>Library Settings</span>
                </a>
            </nav>
            <div class="sidebar-footer">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="user-avatar"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <div class="fw-bold small text-truncate" style="max-width:110px">@User.Identity?.Name</div>
                            <span class="badge text-bg-light" style="font-size:.65rem">Administrator</span>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button class="btn btn-outline-danger btn-sm p-1 px-2" title="Sign out" type="submit">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="main-wrapper">
            <header class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="appSidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <span class="topbar-context"><span class="status-dot"></span> Library operations <span class="text-secondary">/ @ViewData["Title"]</span></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="AdminReports" asp-action="Index">
                        <i class="bi bi-graph-up me-1"></i> Reports
                    </a>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="AdminProfile" asp-action="Index">
                        <i class="bi bi-person me-1"></i> My Profile
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-gear"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" asp-controller="AdminProfile" asp-action="Index"><i class="bi bi-person me-2"></i>Admin Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                            <li><a class="dropdown-item" asp-controller="AdminSettings" asp-action="Index"><i class="bi bi-sliders me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                    <button class="dropdown-item text-danger rounded" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="container-fluid px-3 px-lg-4 py-4">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <div>@success</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@error</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <!-- Public & Member Layout -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-book-half"></i></span>
                <span>Shelfwise</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="mainNav" class="collapse navbar-collapse">
                @if (SignInManager.IsSignedIn(User))
                {
                    <ul class="navbar-nav me-auto ms-lg-4 gap-lg-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-1"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index"><i class="bi bi-book me-1"></i> Catalogue</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-1"></i> My Profile</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <span class="user-avatar" style="width:22px;height:22px;font-size:.7rem"><i class="bi bi-person"></i></span>
                                <span>@User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        <button class="dropdown-item text-danger rounded" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <ul class="navbar-nav me-auto ms-lg-4">
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Browse Books</a></li>
                    </ul>
                    <div class="ms-auto d-flex gap-2 py-2 py-lg-0">
                        <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create account</a>
                    </div>
                }
            </div>
        </div>
    </nav>
    <main class="container-fluid px-3 px-lg-4 py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div>@success</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>@error</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>
    <footer class="container-fluid px-4 py-4 text-secondary small border-top mt-auto text-center">
        Shelfwise Library Management System · Enterprise Edition
    </footer>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
